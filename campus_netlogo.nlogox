to update-copresence-plot
  set-current-plot "Copresence time"

  let time-min sim-time-seconds / 60
  let selected-mode "all"

  set-current-plot-pen "car"
  plotxy time-min
    average-copresence-car-percentage selected-mode

  set-current-plot-pen "bike"
  plotxy time-min
    average-copresence-bike-percentage selected-mode

  set-current-plot-pen "pedestrian"
  plotxy time-min
    average-copresence-pedestrian-percentage selected-mode
end

to-report indicator-values [indicator-name transport-mode]

  let records completed-trip-records-by-mode transport-mode

  if indicator-name = "duration" [
    report map [r -> item 1 r] records
  ]

  if indicator-name = "speed" [
    report map [r -> item 2 r] records
  ]

  if indicator-name = "distance" [
    report map [r -> item 3 r] records
  ]

  if indicator-name = "congestion" [
    report map [r -> item 4 r] records
  ]

  if indicator-name = "low-speed-duration" [
    report map [r -> item 5 r] records
  ]

  if indicator-name = "intermediate-speed-duration" [
    report map [r -> item 6 r] records
  ]

  if indicator-name = "high-speed-duration" [
    report map [r -> item 7 r] records
  ]

  if indicator-name = "copresence-car" [
    set records filter [
      r -> item 0 r != "car"
    ] records
    report map [
      r -> 100 * item 8 r
    ] records
  ]

  if indicator-name = "copresence-bike" [
    set records filter [
      r -> item 0 r != "bike"
    ] records
    report map [
      r -> 100 * item 9 r
    ] records
  ]

  if indicator-name = "copresence-pedestrian" [
    set records filter [
      r -> item 0 r != "pedestrian"
    ] records
    report map [
      r -> 100 * item 10 r
    ] records
  ]

  report []
end

to-report selected-indicator-values

  if selected-indicator = "copresence" [

    if copresence-target = "car" [
      report indicator-values "copresence-car" plot-mode
    ]

    if copresence-target = "bike" [
      report indicator-values "copresence-bike" plot-mode
    ]

    report indicator-values "copresence-pedestrian" plot-mode
  ]

  report indicator-values selected-indicator plot-mode
end

to-report mean-or-zero [values]
  if empty? values [
    report 0
  ]

  report mean values
end

to-report last-n-values [values number-of-values]

  if empty? values [
    report []
  ]

  let n max (list 1 floor number-of-values)

  if length values <= n [
    report values
  ]

  report sublist values (length values - n) length values
end

to-report histogram-interval-for [values]

  if empty? values [
    report 1
  ]

  if length values = 1 [
    report 1
  ]

  let minimum-value min values
  let maximum-value max values

  let value-range
    maximum-value - minimum-value

  if value-range <= 0 [
    report 1
  ]

  let number-of-bins
    round sqrt length values

  set number-of-bins
    max (list 5 number-of-bins)

  set number-of-bins
    min (list 15 number-of-bins)

  report value-range / number-of-bins
end
 
to-report current-plot-signature
  report (word
    selected-indicator "|"
    plot-view "|"
    plot-mode "|"
    copresence-target "|"
    sliding-window-size)
end

to update-indicator-plot

  set-current-plot "Indicator plot"

  let signature current-plot-signature

  if signature != last-plot-signature [
    clear-plot
    set last-plot-signature signature
  ]

  let values selected-indicator-values
  let time-min sim-time-seconds / 60

  if plot-view = "mean" [
    set-current-plot-pen "value"
    set-plot-pen-mode 0

    plotxy time-min (mean-or-zero values)
  ]

  if plot-view = "sliding" [
    let sliding-values
      last-n-values values sliding-window-size

    set-current-plot-pen "value"
    set-plot-pen-mode 0

    plotxy time-min (mean-or-zero sliding-values)
  ]

  if plot-view = "histogram" [
    clear-plot
    set-current-plot-pen "value"
    set-plot-pen-mode 1
    
    if not empty? values [
      set-plot-pen-interval histogram-interval-for values
      histogram values
    ]
  ]

end

to-report selected-indicator-mean
  report mean-or-zero selected-indicator-values
end

to-report selected-indicator-unit

  if selected-indicator = "speed" [
    report "km/h"
  ]

  if selected-indicator = "distance" [
    report "km"
  ]

  if selected-indicator = "copresence" [
    report "%"
  ]

  report "min"
end

to clear-encounter-heatmap

  ask patches [
    set encounter-count 0
    set pcolor white
  ]

end

to export-encounter-heatmap

  if show-encounter-heatmap? [
    update-encounter-heatmap
  ]

  display

  export-view
    (word "outputs/encounter_heatmap_run_" run-id ".png")

  show (word
    "Encounter heatmap exported to outputs/encounter_heatmap_run_"
    run-id
    ".png"
  )

end

to run-multiple-simulations
  let total-runs max (list 1 (round number-of-runs))
  let current-batch-run 1
  show (word
    "Starting batch of "
    total-runs
    " simulations."
  )
  no-display
  while [current-batch-run <= total-runs] [
    show (word
      "Preparing batch simulation "
      current-batch-run
      " of "
      total-runs
      "."
    )
    setup-real-flow-simulation
    show (word
      "Running simulation with run-id "
      run-id
      "."
    )
    while [not real-flow-simulation-finished?] [
      go-real-flow-step
    ]
    finish-real-flow-run
    show (word
      "Completed batch simulation "
      current-batch-run
      " of "
      total-runs
      "."
    )
    set current-batch-run current-batch-run + 1
  ]

  display

  user-message
    (word
      total-runs
      " simulations completed and exported."
    )
end

to finish-real-flow-run

  if not results-exported? [

    close-all-active-encounters

    if show-encounter-heatmap? [
      update-encounter-heatmap
      export-encounter-heatmap
    ]

    export-trip-results
    export-simulation-summary
    export-encounters

    set results-exported? true

    show (word
      "Run "
      run-id
      " finished and exported."
    )
  ]
end

to go-real-flow-step
  generate-scheduled-real-agents
  update-copresence-times
  update-encounters
  update.mobile-agent.speed
  move.mobile-agents
  update-speed-duration-times
  update-indicator-plot
  if show-encounter-heatmap? [
    if ticks mod 25 = 0 [
      update-encounter-heatmap
    ]
  ]
  set sim-time-seconds
    sim-time-seconds + seconds-per-tick
  tick
end

to go-real-flow

  if real-flow-simulation-finished? [
    finish-real-flow-run

    user-message
      (word
        "Real flow simulation finished. "
        "Results exported for run "
        run-id
        "."
      )

    stop
  ]

  go-real-flow-step

  if real-flow-simulation-finished? [
    finish-real-flow-run

    user-message
      (word
        "Real flow simulation finished. "
        "Results exported for run "
        run-id
        "."
      )

    stop
  ]
end

to export-encounters

  let output-file
    (word
      "outputs/encounters_run_"
      run-id
      ".csv"
    )

  file-close-all

  if file-exists? output-file [
    file-delete output-file
  ]

  file-open output-file

  file-print
    (word
      "run_id,"
      "encounter_id,"
      "agent_1_id,"
      "agent_1_mode,"
      "agent_2_id,"
      "agent_2_mode,"
      "start_time_s,"
      "end_time_s,"
      "duration_s,"
      "start_x,"
      "start_y,"
      "end_x,"
      "end_y,"
      "minimum_distance_m"
    )

  foreach completed-encounters [
    record ->

    file-print
      (word
        run-id ","
        item 0 record ","
        item 1 record ","
        item 2 record ","
        item 3 record ","
        item 4 record ","
        precision (item 5 record) 3 ","
        precision (item 6 record) 3 ","
        precision (item 7 record) 3 ","
        precision (item 8 record) 6 ","
        precision (item 9 record) 6 ","
        precision (item 10 record) 6 ","
        precision (item 11 record) 6 ","
        precision (item 12 record) 3
      )
  ]

  file-close

  show
    (word
      "Encounters exported to "
      output-file
    )
end

to export-trip-results

  let output-file
    (word
      "outputs/trip_results_run_"
      run-id
      ".csv"
    )

  file-close-all

  if file-exists? output-file [
    file-delete output-file
  ]

  file-open output-file

  file-print
    (word
      "run_id,"
      "mode,"
      "origin_zone,"
      "destination_zone,"
      "flow_slot,"
      "scheduled_spawn_time_s,"
      "arrival_time_s,"
      "trajectory_duration_min,"
      "average_speed_kmh,"
      "trajectory_distance_km,"
      "congestion_duration_min,"
      "low_speed_duration_min,"
      "intermediate_speed_duration_min,"
      "high_speed_duration_min,"
      "copresence_car_percentage,"
      "copresence_bike_percentage,"
      "copresence_pedestrian_percentage"
    )

  foreach completed-trip-metrics [
    record ->

    file-print
      (word
        run-id ","
        item 0 record ","
        item 11 record ","
        item 12 record ","
        item 13 record ","
        precision (item 14 record) 3 ","
        precision (item 15 record) 3 ","
        precision (item 1 record) 6 ","
        precision (item 2 record) 6 ","
        precision (item 3 record) 6 ","
        precision (item 4 record) 6 ","
        precision (item 5 record) 6 ","
        precision (item 6 record) 6 ","
        precision (item 7 record) 6 ","
        precision (100 * item 8 record) 6 ","
        precision (100 * item 9 record) 6 ","
        precision (100 * item 10 record) 6
      )
  ]

  file-close

  show (word
    "Trip results exported to "
    output-file
  )
end

to export-simulation-summary

  let output-file
    (word
      "outputs/simulation_summary_run_"
      run-id
      ".csv"
    )

  file-close-all

  if file-exists? output-file [
    file-delete output-file
  ]

  file-open output-file

  file-print
    (word
      "run_id,"
      "start_slot,"
      "start_time,"
      "configured_duration_min,"
      "actual_end_time_s,"
      "mode,"
      "generated_agents,"
      "completed_trips,"
      "failed_paths,"
      "mean_duration_min,"
      "mean_speed_kmh,"
      "mean_distance_km,"
      "mean_congestion_min,"
      "mean_low_speed_min,"
      "mean_intermediate_speed_min,"
      "mean_high_speed_min,"
      "mean_copresence_car_percentage,"
      "mean_copresence_bike_percentage,"
      "mean_copresence_pedestrian_percentage"
    )

  let transport-modes
    ["all" "car" "bike" "pedestrian"]

  foreach transport-modes [
    transport-mode ->

    file-print
      (word
        run-id ","
        selected-flow-slot ","
        slot-start-time selected-flow-slot ","
        simulation-duration-minutes ","
        precision sim-time-seconds 3 ","
        transport-mode ","
        generated-vehicles ","
        completed-trip-count-by-mode transport-mode ","
        failed-paths ","
        precision
          (average-trajectory-duration-min transport-mode)
          6 ","
        precision
          (average-trajectory-speed-kmh transport-mode)
          6 ","
        precision
          (average-trajectory-distance-km transport-mode)
          6 ","
        precision
          (average-congestion-duration-min transport-mode)
          6 ","
        precision
          (average-low-speed-duration-min transport-mode)
          6 ","
        precision
          (average-intermediate-speed-duration-min transport-mode)
          6 ","
        precision
          (average-high-speed-duration-min transport-mode)
          6 ","
        precision
          (average-copresence-car-percentage transport-mode)
          6 ","
        precision
          (average-copresence-bike-percentage transport-mode)
          6 ","
        precision
          (average-copresence-pedestrian-percentage transport-mode)
          6
      )
  ]

  file-close

  show (word
    "Simulation summary exported to "
    output-file
  )
end]]></code>
