  let time-min sim-time-seconds / 60

  set-current-plot-pen "all"
  plotxy time-min average-trajectory-duration-min "all"

  set-current-plot-pen "car"
  plotxy time-min average-trajectory-duration-min "car"

  set-current-plot-pen "bike"
  plotxy time-min average-trajectory-duration-min "bike"

  set-current-plot-pen "pedestrian"
  plotxy time-min average-trajectory-duration-min "pedestrian"
end

to update-trajectory-speed-plot
  set-current-plot "Trajectory speed"
  
  let time-min sim-time-seconds / 60

  set-current-plot-pen "all"
  plotxy time-min average-trajectory-speed-kmh "all"

  set-current-plot-pen "car"
  plotxy time-min average-trajectory-speed-kmh "car"

  set-current-plot-pen "bike"
  plotxy time-min average-trajectory-speed-kmh "bike"

  set-current-plot-pen "pedestrian"
  plotxy time-min average-trajectory-speed-kmh "pedestrian"
end

to update-trajectory-distance-plot
  set-current-plot "Trajectory distance"

  let time-min sim-time-seconds / 60

  set-current-plot-pen "all"
  plotxy time-min average-trajectory-distance-km "all"

  set-current-plot-pen "car"
  plotxy time-min average-trajectory-distance-km "car"

  set-current-plot-pen "bike"
  plotxy time-min average-trajectory-distance-km "bike"

  set-current-plot-pen "pedestrian"
  plotxy time-min average-trajectory-distance-km "pedestrian"
end

to update-congestion-duration-plot
  set-current-plot "Congestion duration"

  let time-min sim-time-seconds / 60
  
  set-current-plot-pen "all"
  plotxy time-min average-congestion-duration-min "all"

  set-current-plot-pen "car"
  plotxy time-min average-congestion-duration-min "car"

  set-current-plot-pen "bike"
  plotxy time-min average-congestion-duration-min "bike"

  set-current-plot-pen "pedestrian"
  plotxy time-min average-congestion-duration-min "pedestrian"
end

to update-trajectory-speed-duration-plot
  set-current-plot "Trajectory speed duration"

  let time-min sim-time-seconds / 60
  let mode "all"

  set-current-plot-pen "stopped"
  plotxy time-min
    average-congestion-duration-min mode

  set-current-plot-pen "low"
  plotxy time-min
    average-low-speed-duration-min mode

  set-current-plot-pen "intermediate"
  plotxy time-min
    average-intermediate-speed-duration-min mode

  set-current-plot-pen "high"
  plotxy time-min
    average-high-speed-duration-min mode
