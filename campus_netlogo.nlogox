to test-bike-segment-speeds

  if any? mobile-agents [
    user-message "La prueba requiere que no haya agentes circulando."
    stop
  ]

  let cycling-edges edges with [
    road-type != "turn" and
    member? "bike" allowed-modes and
    road-length * meters-per-netlogo-unit > 12
  ]

  let walking-edges edges with [
    road-type != "turn" and
    member? "bike-mixed" allowed-modes and
    not member? "bike" allowed-modes and
    road-length * meters-per-netlogo-unit > 12
  ]

  if not any? cycling-edges or not any? walking-edges [
    user-message "No se encuentran tramos suficientemente largos para la prueba."
    stop
  ]

  let saved-walking-distance bike-walking-distance-total-m

  let cycling-edge max-one-of cycling-edges [road-length]
  let walking-edge max-one-of walking-edges [road-length]

  (foreach
    (list cycling-edge walking-edge)
    (list "CICLISTA" "PEATONAL A PIE")
    (list 15 5)
    [
      [selected-edge label-text expected-speed] ->

      let origin [end1] of selected-edge
      let target [end2] of selected-edge
      let test-agent nobody

      create-bicycles 1 [
        setup-mobile-agent "bike" origin target (list target)

        set speed-factor 1
        set color pink
        set size 0.5
        set test-agent self
      ]

      let measured-distance-m 0
      let steps-to-test 10

      repeat steps-to-test [
        update.mobile-agent.speed
        move.mobile-agents

        set measured-distance-m
          measured-distance-m +
          ([distance-moved-this-tick] of test-agent *
            meters-per-netlogo-unit)
      ]

      let elapsed-seconds steps-to-test * seconds-per-tick

      let measured-speed
        (measured-distance-m / elapsed-seconds) * 3.6

      let passed?
        abs (measured-speed - expected-speed) < 0.001

      show (word
        label-text
        " | esperada: " expected-speed " km/h"
        " | medida: " precision measured-speed 6 " km/h"
        " | correcto: " passed?
      )

      ask test-agent [
        die
      ]
    ]
  )

  set bike-walking-distance-total-m saved-walking-distance
end

to check-scheduled-demand
  let slots selected-flow-slots
  let expected-total 0
  let all-match? true

  foreach slots [slot-value ->
    foreach ["7.1" "7.3" "7.4" "7.5" "7.6"] [zid ->
      foreach ["car" "bike" "pedestrian"] [mode-value ->

        let input-rows filter [row ->
          item 0 row = slot-value and
          item 1 row = zid and
          item 2 row = mode-value and
          item 3 row = "inflow"
        ] flow-counts

        let expected sum (map [row ->
          round (item 4 row)
        ] input-rows)

        let scheduled length (filter [trip ->
          item 7 trip = slot-value and
          item 2 trip = zid and
          item 1 trip = mode-value
        ] scheduled-trips)

        set expected-total expected-total + expected

        if expected != scheduled [
          set all-match? false
        ]

        show (word
          "Slot " slot-value
          " | zona " zid
          " | " mode-value
          " | entradas del escenario: " expected
          " | programados: " scheduled
          " | coincide: " (expected = scheduled)
        )
      ]
    ]
  ]

  show (word
    "TOTAL | entradas del escenario: " expected-total
    " | programados: " length scheduled-trips
    " | fallos: " failed-paths
    " | coincide por zona y modo: " all-match?
  )
end

to check-real-route-permissions-core
  if empty? real-route-cache [
    user-message "Primero ejecuta el setup de flujos reales."
    stop
  ]

  let total-errors 0
  let checked-segments 0

  foreach real-route-cache [route-record ->
    let mode-value item 0 route-record
    let origin-zid item 1 route-record
    let target-zid item 2 route-record
    let current-point item 3 route-record
    let checked-destination item 4 route-record
    let route-path item 5 route-record
    let route-errors 0

    ifelse empty? route-path [
      set route-errors route-errors + 1
    ] [
      if last route-path != checked-destination [
        set route-errors route-errors + 1
      ]

      foreach route-path [target-point ->
        set checked-segments checked-segments + 1

        let matching-edges [my-out-edges] of current-point
        set matching-edges matching-edges with [
          end2 = target-point
        ]

        ifelse not any? matching-edges [
          set route-errors route-errors + 1
        ] [
          let route-edge first sort matching-edges
          let permissions [allowed-modes] of route-edge

          ifelse mode-value = "bike" [
            if not member? "bike-mixed" permissions [
              set route-errors route-errors + 1
            ]

            if [road-type] of route-edge != "turn" and
               not member? "bike" permissions [
              if not member? "pedestrian" permissions [
                set route-errors route-errors + 1
              ]
            ]
          ] [
            if not member? mode-value permissions [
              set route-errors route-errors + 1
            ]
          ]
        ]

        set current-point target-point
      ]
    ]

    if mode-value = "bike" and not empty? route-path [
      let origin-zone first sort flow-zones with [
        zone-id = origin-zid
      ]
      let target-zone first sort flow-zones with [
        zone-id = target-zid
      ]

      let starts get-candidate-nodes-from-zone
        origin-zone "bike" "inflow"
      let finishes get-candidate-nodes-from-zone
        target-zone "bike" "outflow"

      let cycle-only-possible?
        check-cycle-only-reachable? starts finishes

      let full-route fput (item 3 route-record) route-path
      let walking-m bike-path-walking-m full-route

      if cycle-only-possible? and walking-m > 0.000001 [
        set route-errors route-errors + 1
      ]

      show (word
        "BICI " origin-zid " -> " target-zid
        " | existe alternativa solo ciclista: "
        cycle-only-possible?
        " | caminar m: " precision walking-m 3
      )
    ]

    set total-errors total-errors + route-errors

    show (word
      "RUTA " mode-value " " origin-zid " -> " target-zid
      " | errores: " route-errors
    )
  ]

  show (word
    "TOTAL | rutas: " length real-route-cache
    " | segmentos comprobados: " checked-segments
    " | errores: " total-errors
    " | correcto: " (total-errors = 0)
  )
end


to-report check-cycle-only-reachable? [starts finishes]
  let source-list sort starts
  let goal-list filter [point ->
    not member? point source-list
  ] (sort finishes)

  if empty? source-list or empty? goal-list [
    report false
  ]

  let pending source-list
  let seen source-list

  while [not empty? pending] [
    let current-point first pending
    set pending but-first pending

    if member? current-point goal-list [
      report true
    ]

    let outgoing [my-out-edges] of current-point
    let cycling-edges outgoing with [
      member? "bike" allowed-modes
    ]

    foreach sort cycling-edges [route-edge ->
      let neighbor [end2] of route-edge

      if not member? neighbor seen [
        set seen lput neighbor seen
        set pending lput neighbor pending
      ]
    ]
  ]

  report false
end

to check-capacity-and-completion
  if ticks != 0 or generated-vehicles != 0 or results-exported? [
    user-message "Ejecuta primero un nuevo Setup Flow."
    stop
  ]

  let initial-demand length scheduled-trips
  let peak-active 0
  let capacity-blocked-steps 0

  while [not real-flow-run-ended?] [
    let active-before count mobile-agents
    let generated-before generated-vehicles
    let step-start-time sim-time-seconds

    go-real-flow-step

    let active-after-generation
      active-before + generated-vehicles - generated-before

    set peak-active
      max (list peak-active active-after-generation)

    if not empty? scheduled-trips [
      if item 0 first scheduled-trips <= step-start-time and
         active-after-generation >= max-active-vehicles [
        set capacity-blocked-steps
          capacity-blocked-steps + 1
      ]
    ]
  ]

  show (word
    "CAPACIDAD | limite: " max-active-vehicles
    " | maximo observado: " peak-active
    " | pasos con entradas retenidas por capacidad: "
    capacity-blocked-steps
  )

  show (word
    "BALANCE | programados inicialmente: " initial-demand
    " | generados: " generated-vehicles
    " | completados: " completed-trips
    " | activos: " count mobile-agents
    " | pendientes: " length scheduled-trips
    " | fallos: " failed-paths
  )

  show (word
    "FINALIZACION | estado: " real-flow-run-status
    " | tiempo simulado s: " precision sim-time-seconds 3
  )

  finish-real-flow-run
end

to test-heatmap-randomness
  let saved-setting show-encounter-heatmap?
  let all-ok? true

  foreach [true false] [setting ->
    set show-encounter-heatmap? setting

    with-local-randomness [
      let expected-value 0

      with-local-randomness [
        set expected-value random 1000000000
      ]

      update-encounter-heatmap

      let observed-value random 1000000000
      let correct? (observed-value = expected-value)

      if not correct? [
        set all-ok? false
      ]

      show (word
        "ALEATORIEDAD | heatmap: " setting
        " | secuencia conservada: " correct?
      )
    ]
  ]

  set show-encounter-heatmap? saved-setting
  update-encounter-heatmap

  show (word
    "TOTAL | actualizacion del heatmap no altera la secuencia: "
    all-ok?
  )
end

to test-roundabout-priority
  clear-all

  set seconds-per-tick 0.2
  set deadlock-release-time 4
  set roundabout-priority-radius 0.35
  set right-priority-radius 0.30

  let approach-point nobody
  let entry-point nobody
  let exit-point nobody
  let circulating-origin nobody
  let entering-car nobody
  let circulating-car nobody

  create-nodes 1 [
    setxy 0 -1
    set roundabout-node? false
    set intersection? false
    set approach-point self
  ]

  create-nodes 1 [
    setxy 0 0
    set roundabout-node? true
    set intersection? false
    set entry-point self
  ]

  create-nodes 1 [
    setxy 1 0
    set roundabout-node? true
    set intersection? false
    set exit-point self
  ]

  create-nodes 1 [
    setxy -1 0
    set roundabout-node? true
    set intersection? false
    set circulating-origin self
  ]

  ask approach-point [
    create-edge-to entry-point [
      set roundabout? false
      set road-type "oneway"
      set allowed-modes ["car"]
      set road-length 1
    ]
  ]

  ask entry-point [
    create-edge-to exit-point [
      set roundabout? true
      set road-type "roundabout"
      set allowed-modes ["car"]
      set road-length 1
    ]
  ]

  ask circulating-origin [
    create-edge-to entry-point [
      set roundabout? true
      set road-type "roundabout"
      set allowed-modes ["car"]
      set road-length 1
    ]
  ]

  create-vehicles 1 [
    set agent-mode "car"
    set current-node approach-point
    set next-node entry-point
    set previous-node nobody
    set destination-node exit-point
    set path (list exit-point)
    set waiting-time 0
    set arrived? false
    set stopped? false
    set roundabout-inside? false
    setxy 0 -0.2
    set heading 0
    set color yellow
    set shape "car"
    set size 0.15
    set entering-car self
  ]

  create-vehicles 1 [
    set agent-mode "car"
    set current-node circulating-origin
    set next-node entry-point
    set previous-node nobody
    set destination-node exit-point
    set path (list exit-point)
    set waiting-time 0
    set arrived? false
    set stopped? false
    set roundabout-inside? true
    setxy -0.2 0
    set heading 90
    set color blue
    set shape "car"
    set size 0.15
    set circulating-car self
  ]

  reset-ticks

  show "PRUEBA 1 | Aproximacion con un coche dentro"

  ask entering-car [
    let blocked? traffic-priority-blocked? next-node

    show (word
      "Debe ceder: true"
      " | resultado: " blocked?
      " | correcto: " blocked?
    )
  ]

  show "PRUEBA 2 | Inicio del primer enlace de rotonda"

  ask entering-car [
    move-to entry-point
    set previous-node approach-point
    set current-node entry-point
    set next-node exit-point
    set path []
    face next-node

    show (word
      "Siguiente enlace de rotonda: "
      (next-edge-roundabout? next-node)
      " | considerado ya dentro: " on-roundabout?
    )

    let blocked? roundabout-entry-blocked? next-node

    show (word
      "Debe ceder antes de incorporarse: true"
      " | resultado: " blocked?
      " | correcto: " blocked?
    )
  ]

  show "PRUEBA 3 | Entrada libre"

  ask circulating-car [ die ]

  ask entering-car [
    set current-node approach-point
    set next-node entry-point
    set previous-node nobody
    set path (list exit-point)
    set waiting-time 0
    setxy 0 -0.2
    face next-node

    let blocked? traffic-priority-blocked? next-node

    show (word
      "Debe ceder: false"
      " | resultado: " blocked?
      " | correcto: " (not blocked?)
    )
  ]

  show "Fin del diagnostico. Ejecutar setup antes de volver al modelo."
end

to test-roundabout-movement
  clear-all

  set seconds-per-tick 0.2
  set meters-per-netlogo-unit 21.39540387800133
  set movement-step-size 0.03
  set vehicle-safety-distance 0.12
  set right-priority-radius 0.30
  set roundabout-priority-radius 0.35
  set deadlock-release-time 4
  set sim-time-seconds 0
  set bike-walking-distance-total-m 0

  let test-points []

  foreach [
    [0 -1]
    [0 0]
    [0 0.1]
    [1 0.1]
    [1 0.2]
    [2 0.2]
    [-1 0]
  ] [
    coords ->
    create-nodes 1 [
      setxy item 0 coords item 1 coords
      set intersection? false
      set roundabout-node? false
      set shape "circle"
      set size 0.08
      set color gray
      set test-points lput self test-points
    ]
  ]

  let approach-point item 0 test-points
  let entry-point item 1 test-points
  let ring-start item 2 test-points
  let ring-end item 3 test-points
  let exit-point item 4 test-points
  let outside-point item 5 test-points
  let blocker-origin item 6 test-points

  ask (turtle-set entry-point ring-start ring-end exit-point blocker-origin) [
    set roundabout-node? true
  ]

  foreach [
    [0 1 "oneway"]
    [1 2 "turn"]
    [2 3 "roundabout"]
    [3 4 "turn"]
    [4 5 "oneway"]
    [6 1 "roundabout"]
  ] [
    specification ->
    let source-point item (item 0 specification) test-points
    let target-point item (item 1 specification) test-points
    let link-kind item 2 specification

    ask source-point [
      create-edge-to target-point [
        set road-type link-kind
        set roundabout? (link-kind = "roundabout")
        set allowed-modes ["car"]
        set road-length [distance target-point] of source-point
        set color white
      ]
    ]
  ]

  let entering-car nobody
  let circulating-car nobody

  create-vehicles 1 [
    set agent-mode "car"
    set current-node approach-point
    set next-node entry-point
    set previous-node nobody

    set destination-node nobody
    set path (list ring-start ring-end exit-point outside-point)

    set roundabout-inside? false
    set arrived? false
    set stopped? false
    set waiting-time 0
    set speed-factor 1
    set speed 0.02
    set trip-distance-m 0
    set distance-moved-this-tick 0

    setxy 0 -0.2
    set shape "car"
    set size 0.15
    set color yellow
    set entering-car self
  ]

  create-vehicles 1 [
    set agent-mode "car"
    set current-node blocker-origin
    set next-node entry-point
    set previous-node nobody
    set destination-node nobody
    set path []
    set roundabout-inside? true
    set arrived? false
    set stopped? false
    set waiting-time 0
    set speed 0

    setxy -0.1 0
    set shape "car"
    set size 0.15
    set color blue
    set circulating-car self
  ]

  reset-ticks

  let initial-x [xcor] of entering-car
  let initial-y [ycor] of entering-car

  move.mobile-agents

  let held? (
    ([distancexy initial-x initial-y] of entering-car < 0.000001)
    and [stopped?] of entering-car
    and [waiting-time] of entering-car > 0
  )

  show (word
    "MOVIMIENTO 1 | Espera con entrada ocupada"
    " | correcto: " held?
  )

  ask circulating-car [ die ]

  move.mobile-agents

  let resumed? (
    [distancexy initial-x initial-y] of entering-car > 0.000001
  )

  show (word
    "MOVIMIENTO 2 | Avanza al quedar libre"
    " | correcto: " resumed?
  )

  let saw-entry-turn? false
  let entry-turn-ok? true
  let saw-ring? false
  let ring-ok? true
  let saw-exit-turn? false
  let exit-turn-ok? true
  let saw-outside? false
  let outside-ok? true
  let iterations 0

  while [
    iterations < 250 and
    [current-node] of entering-car != outside-point
  ] [
    move.mobile-agents
    set sim-time-seconds sim-time-seconds + seconds-per-tick
    tick
    set iterations iterations + 1

    ask entering-car [
      if current-node = entry-point and next-node = ring-start [
        if distance-moved-this-tick > 0 [
          set saw-entry-turn? true
          if on-roundabout? [
            set entry-turn-ok? false
          ]
        ]
      ]

      if current-node = ring-start and next-node = ring-end [
        if distance-moved-this-tick > 0 [
          set saw-ring? true
          if not on-roundabout? [
            set ring-ok? false
          ]
        ]
      ]

      if current-node = ring-end and next-node = exit-point [
        if distance-moved-this-tick > 0 [
          set saw-exit-turn? true
          if not on-roundabout? [
            set exit-turn-ok? false
          ]
        ]
      ]

      if current-node = exit-point and next-node = outside-point [
        if distance-moved-this-tick > 0 [
          set saw-outside? true
          if on-roundabout? [
            set outside-ok? false
          ]
        ]
      ]
    ]
  ]

  show (word
    "MOVIMIENTO 3 | Conector de entrada conserva estado exterior"
    " | observado: " saw-entry-turn?
    " | correcto: " (saw-entry-turn? and entry-turn-ok?)
  )

  show (word
    "MOVIMIENTO 4 | Circulacion interior activa el estado"
    " | observado: " saw-ring?
    " | correcto: " (saw-ring? and ring-ok?)
  )

  show (word
    "MOVIMIENTO 5 | Conector de salida conserva estado interior"
    " | observado: " saw-exit-turn?
    " | correcto: " (saw-exit-turn? and exit-turn-ok?)
  )

  show (word
    "MOVIMIENTO 6 | Tramo exterior desactiva el estado"
    " | observado: " saw-outside?
    " | correcto: " (saw-outside? and outside-ok?)
  )

  let finished? ([current-node] of entering-car = outside-point)

  show (word
    "MOVIMIENTO 7 | Recorrido terminado"
    " | correcto: " finished?
  )

  let all-ok? (
    held? and resumed? and
    saw-entry-turn? and entry-turn-ok? and
    saw-ring? and ring-ok? and
    saw-exit-turn? and exit-turn-ok? and
    saw-outside? and outside-ok? and
    finished?
  )

  show (word "TOTAL | movimiento y estados correctos: " all-ok?)
end

to check-gis-endpoint-matching
  with-local-randomness [
    let unmatched []
    let checked 0

    foreach gis:feature-list-of edges-dataset [feat ->
      let road-reference gis:property-value feat "ID_"
      let direction-value word (gis:property-value feat "ONEWAY_") ""
      let round-value word (gis:property-value feat "ISROUND_") ""

      let directions []

      ifelse round-value = "true" [
        set directions ["forward"]
      ] [
        if direction-value = "yes" [
          set directions ["forward"]
        ]

        if direction-value = "" or direction-value = "no" [
          set directions ["forward" "backward"]
        ]
      ]

      foreach gis:vertex-lists-of feat [vertices ->
        let locations []

        foreach vertices [vertex ->
          let location gis:location-of vertex

          if not empty? location [
            set locations lput location locations
          ]
        ]

        set locations
          remove-consecutive-duplicate-locations locations

        if length locations >= 2 [
          foreach (list (first locations) (last locations)) [location ->
            let location-key coord-key location
            let location-x item 0 location
            let location-y item 1 location

            foreach directions [direction-name ->
              set checked checked + 1

              let matches nodes with [
                node-key = location-key and
                lane-direction = direction-name
              ]

              if not any? matches [
                let available nodes with [
                  lane-direction = direction-name
                ]

                ifelse any? available [
                  let nearest min-one-of available [
                    distancexy location-x location-y
                  ]

                  let offset-m
                    ([distancexy location-x location-y] of nearest) *
                    meters-per-netlogo-unit

                  set unmatched lput
                    (list
                      road-reference
                      direction-name
                      offset-m
                      [who] of nearest
                    )
                    unmatched
                ] [
                  show (word
                    "SIN NODOS | via: " road-reference
                    " | sentido: " direction-name
                  )
                ]
              ]
            ]
          ]
        ]
      ]

    ]

    set unmatched sort-by [
      [a b] -> (item 2 a) > (item 2 b)
    ] unmatched
    
    set gis-endpoint-audit unmatched

    show (word
      "EXTREMOS | comprobaciones: " checked
      " | sin coincidencia exacta: " length unmatched
    )

    foreach [0.01 1 5 10] [threshold-m ->
      show (word
        "Desplazamiento superior a " threshold-m " m: "
        length (filter [
          record -> (item 2 record) > threshold-m
        ] unmatched)
      )
    ]

    show "Hasta 10 casos con mayor desplazamiento:"

    foreach (first-n-items 10 unmatched) [record ->
      show (word
        "Via: " item 0 record
        " | sentido: " item 1 record
        " | desplazamiento m: " precision (item 2 record) 3
        " | nodo elegido: " item 3 record
      )
    ]
  ]
end

to check-routes-with-displaced-endpoints
  if not is-list? gis-endpoint-audit [
    user-message "Ejecuta primero check-gis-endpoint-matching."
    stop
  ]

  if empty? real-route-cache [
    user-message "Primero ejecuta Setup Flow."
    stop
  ]

  let relevant-cases filter [
    record -> (item 2 record) > 0.01
  ] gis-endpoint-audit

  let affected-road-ids remove-duplicates
    (map [
      record -> word (item 0 record) ""
    ] relevant-cases)

  let routes-to-review 0
  let used-affected-roads []

  foreach real-route-cache [route-record ->
    let transport-mode item 0 route-record
    let origin-zone item 1 route-record
    let target-zone item 2 route-record

    let full-route
      fput (item 3 route-record) (item 5 route-record)

    let matching-roads []

    (foreach (but-last full-route) (but-first full-route) [
      [source-point target-point] ->

      let matching-edges [my-out-edges] of source-point

      set matching-edges matching-edges with [
        end2 = target-point and
        road-type != "turn"
      ]

      if any? matching-edges [
        let route-edge first sort matching-edges
        let road-reference
          word ([edge-road-id] of route-edge) ""

        if member? road-reference affected-road-ids [
          set matching-roads
            lput road-reference matching-roads
        ]
      ]
    ])

    set matching-roads remove-duplicates matching-roads

    if not empty? matching-roads [
      set routes-to-review routes-to-review + 1

      set used-affected-roads
        sentence used-affected-roads matching-roads

      show (word
        "REVISAR | " transport-mode
        " | " origin-zone " -> " target-zone
        " | vias: " matching-roads
      )
    ]
  ]

  set used-affected-roads
    remove-duplicates used-affected-roads

  show (word
    "TOTAL | rutas precalculadas: " length real-route-cache
    " | rutas que utilizan vias a revisar: " routes-to-review
    " | vias distintas a revisar: " length used-affected-roads
  )

  foreach used-affected-roads [road-reference ->
    let cases-for-road filter [
      record ->
        (word (item 0 record) "") = road-reference
    ] relevant-cases

    let maximum-offset
      max (map [record -> item 2 record] cases-for-road)

    show (word
      "VIA UTILIZADA | identificador: " road-reference
      " | mayor desplazamiento de sus extremos m: "
      precision maximum-offset 3
    )
  ]
end

to test-trip-time-accounting
  let saved-car-speed vehicle-speed-kmh

  (foreach [0.5 2.5] [0.2 0.6] [
    [distance-m expected-seconds] ->

    clear-all

    set vehicle-speed-kmh 18
    set meters-per-netlogo-unit 21.39540387800133
    set seconds-per-tick 0.2
    set movement-step-size 0.03
    set vehicle-safety-distance 0.12
    set right-priority-radius 0.30
    set roundabout-priority-radius 0.35
    set deadlock-release-time 4

    set copresence-distance-car-m 5
    set copresence-distance-bike-m 3
    set copresence-distance-pedestrian-m 2
    set encounter-distance-m 5

    set completed-trip-metrics []
    set active-encounters []
    set completed-encounters []
    set next-encounter-id 1

    let source-point nobody
    let target-point nobody

    create-nodes 1 [
      setxy 0 0
      set intersection? false
      set roundabout-node? false
      set source-point self
    ]

    create-nodes 1 [
      setxy (distance-m / meters-per-netlogo-unit) 0
      set intersection? false
      set roundabout-node? false
      set target-point self
    ]

    ask source-point [
      create-edge-to target-point [
        set allowed-modes ["car"]
        set road-type "oneway"
        set roundabout? false
        set road-length distance-m / meters-per-netlogo-unit
      ]
    ]

    create-vehicles 1 [
      setup-mobile-agent
        "car" source-point target-point (list target-point)
      set speed-factor 1
    ]

    set generated-vehicles 1
    reset-ticks

    let steps 0

    while [any? mobile-agents and steps < 10] [
      go-manual
      set steps steps + 1
    ]

    ifelse length completed-trip-metrics = 1 [
      let record first completed-trip-metrics
      let measured-seconds 60 * item 1 record

      let classified-seconds
        60 * sum (sublist record 4 8)

      let expected-average-speed
        3.6 * distance-m / expected-seconds

      let correct? (
        completed-trips = 1 and
        not any? mobile-agents and
        abs (measured-seconds - expected-seconds) < 0.000001 and
        abs (classified-seconds - expected-seconds) < 0.000001 and
        abs (1000 * item 3 record - distance-m) < 0.000001 and
        abs (item 2 record - expected-average-speed) < 0.000001 and
        abs (item 15 record - expected-seconds) < 0.000001
      )

      show (word
        "CIERRE | distancia m: " distance-m
        " | duracion s: " precision measured-seconds 6
        " | tiempo clasificado s: " precision classified-seconds 6
        " | correcto: " correct?
      )
    ] [
      show (word
        "CIERRE | distancia m: " distance-m
        " | registros: " length completed-trip-metrics
        " | correcto: false"
      )
    ]
  ])

  set vehicle-speed-kmh saved-car-speed
  show "Fin de la prueba. Ejecutar Setup Flow para recuperar el campus."
end

to-report real-flow-run-ended?
  report real-flow-simulation-finished? or
    sim-time-seconds >= run-time-limit-seconds
end

to-report real-flow-run-status
  if real-flow-simulation-finished? [
    report "completed"
  ]

  if sim-time-seconds >= run-time-limit-seconds [
    report "time_limit"
  ]

  report "running"
end

to test-following-gap
  clear-all

  set seconds-per-tick 0.2
  set meters-per-netlogo-unit 21.39540387800133
  set movement-step-size 0.03
  set vehicle-safety-distance 0.12
  set right-priority-radius 0.30
  set roundabout-priority-radius 0.35
  set deadlock-release-time 4

  let source-point nobody
  let target-point nobody
  let follower nobody
  let leader nobody

  create-nodes 1 [
    setxy 0 0
    set intersection? false
    set roundabout-node? false
    set source-point self
  ]

  create-nodes 1 [
    setxy 10 0
    set intersection? false
    set roundabout-node? false
    set target-point self
  ]

  ask source-point [
    create-edge-to target-point [
      set allowed-modes ["car"]
      set road-type "oneway"
      set roundabout? false
      set road-length 10
    ]
  ]

  create-vehicles 1 [
    setup-mobile-agent "car" source-point nobody []
    set next-node target-point
    set speed 0.03
    set follower self
  ]

  create-vehicles 1 [
    setup-mobile-agent "car" source-point nobody []
    set next-node target-point
    setxy 0.13 0
    set speed 0
    set leader self
  ]

  reset-ticks

  move.mobile-agents

  let first-gap [distance leader] of follower
  let first-advance [xcor] of follower

  let first-ok? (
    abs (first-gap - vehicle-safety-distance) < 0.000001 and
    abs (first-advance - 0.01) < 0.000001
  )

  show (word
    "SEPARACION 1 | avance limitado al hueco"
    " | separacion: " precision first-gap 6
    " | correcto: " first-ok?
  )

  let held-position [xcor] of follower

  repeat 10 [
    move.mobile-agents
  ]

  let held-ok? (
    abs ([xcor] of follower - held-position) < 0.000001
  )

  show (word
    "SEPARACION 2 | permanece detenido sin espacio"
    " | correcto: " held-ok?
  )

  ask leader [
    setxy 0.25 0
  ]

  move.mobile-agents

  let resumed-ok? (
    [xcor] of follower > held-position and
    [distance leader] of follower >=
      vehicle-safety-distance - 0.000001
  )

  show (word
    "SEPARACION 3 | avanza al liberarse espacio"
    " | correcto: " resumed-ok?
  )

  ask leader [
    setxy 1 0
  ]

  ask follower [
    set speed 0.2
  ]

  let repeated-ok? true

  repeat 30 [
    move.mobile-agents

    if [distance leader] of follower <
       vehicle-safety-distance - 0.000001 [
      set repeated-ok? false
    ]

    if [xcor] of follower >= [xcor] of leader [
      set repeated-ok? false
    ]
  ]

  show (word
    "SEPARACION 4 | varios subpasos sin invadir la separacion"
    " | correcto: " repeated-ok?
  )

  show (word
    "TOTAL | seguimiento correcto: "
    (first-ok? and held-ok? and resumed-ok? and repeated-ok?)
  )

  show "Fin de la prueba. Ejecutar Setup Flow para recuperar el campus."
end

to test-intersection-priority
  clear-all

  set seconds-per-tick 0.2
  set meters-per-netlogo-unit 21.39540387800133
  set right-priority-radius 0.30
  set roundabout-priority-radius 0.35
  set deadlock-release-time 4

  let test-points []

  foreach [
    [0 -1]
    [1 0]
    [0 1]
    [0 0]
    [0 0]
  ] [coordinates ->
    create-nodes 1 [
      setxy (item 0 coordinates) (item 1 coordinates)
      set node-key coord-key coordinates
      set intersection? false
      set roundabout-node? false
      set test-points lput self test-points
    ]
  ]

  let south-point item 0 test-points
  let east-point item 1 test-points
  let north-point item 2 test-points
  let junction-a item 3 test-points
  let junction-b item 4 test-points

  foreach (list
    (list south-point junction-a)
    (list east-point junction-b)
    (list junction-b north-point)
  ) [connection ->
    let source-point item 0 connection
    let target-point item 1 connection

    ask source-point [
      create-edge-to target-point [
        set road-type "oneway"
        set roundabout? false
        set allowed-modes ["car"]
        set road-length [distance target-point] of source-point
      ]
    ]
  ]

  ask junction-a [
    create-edge-to junction-b [
      set road-type "turn"
      set roundabout? false
      set allowed-modes ["car"]
      set road-length 0.01
    ]
  ]

  identify-traffic-nodes

  let recognition-ok? (
    [intersection?] of junction-a and
    [intersection?] of junction-b
  )

  show (word
    "CRUCE 1 | reconocimiento conjunto de nodos"
    " | correcto: " recognition-ok?
  )

  let approaching-car nobody
  let other-car nobody

  create-vehicles 1 [
    setup-mobile-agent
      "car" south-point north-point
      (list junction-a junction-b north-point)

    set next-node junction-a
    set path (list junction-b north-point)
    set heading 0
    set approaching-car self
  ]

  create-vehicles 1 [
    setup-mobile-agent
      "car" east-point north-point
      (list junction-b north-point)

    set next-node junction-b
    set path (list north-point)
    setxy 0.1 0
    set heading 270
    set other-car self
  ]

  let distant-ok? false
  let near-ok? false
  let left-ok? false
  let free-ok? false

  ask approaching-car [
    setxy 0 -1
    set heading 0

    set distant-ok?
      not (traffic-priority-blocked? next-node)

    setxy 0 -0.2
    set heading 0

    set near-ok?
      traffic-priority-blocked? next-node
  ]

  show (word
    "CRUCE 2 | no cede desde lejos"
    " | correcto: " distant-ok?
  )

  show (word
    "CRUCE 3 | cede cerca ante agente por la derecha"
    " | correcto: " near-ok?
  )

  ask other-car [
    setxy -0.1 0
  ]

  ask approaching-car [
    set left-ok?
      not (traffic-priority-blocked? next-node)
  ]

  show (word
    "CRUCE 4 | agente a la izquierda no activa esta regla"
    " | correcto: " left-ok?
  )

  ask other-car [ die ]

  ask approaching-car [
    set free-ok?
      not (traffic-priority-blocked? next-node)
  ]

  show (word
    "CRUCE 5 | entrada libre"
    " | correcto: " free-ok?
  )

  show (word
    "TOTAL | prioridad de interseccion correcta: "
    (recognition-ok? and distant-ok? and near-ok?
      and left-ok? and free-ok?)
  )

  show "Fin de la prueba. Ejecutar Setup Flow para recuperar el campus."
end

to export-encounters

  let output-file
    (word
      "outputs/encounters_run_"
      run-id
      ".csv"
    )

  file-close-all

  if file-exists? output-file [
    file-delete output-file
  ]

  file-open output-file

  file-print
    (word
      "run_id,"
      "seed,"
      "demand_factor,"
      "encounter_id,"
      "agent_1_id,"
      "agent_1_mode,"
      "agent_2_id,"
      "agent_2_mode,"
      "start_time_s,"
      "end_time_s,"
      "duration_s,"
      "start_x,"
      "start_y,"
      "end_x,"
      "end_y,"
      "minimum_distance_m"
    )

  foreach completed-encounters [
    record ->

    file-print
      (word
        run-id ","
        run-seed ","
        run-demand-factor ","
        item 0 record ","
        item 1 record ","
        item 2 record ","
        item 3 record ","
        item 4 record ","
        precision (item 5 record) 3 ","
        precision (item 6 record) 3 ","
        precision (item 7 record) 3 ","
        precision (item 8 record) 6 ","
        precision (item 9 record) 6 ","
        precision (item 10 record) 6 ","
        precision (item 11 record) 6 ","
        precision (item 12 record) 3
      )
  ]

  file-close

  show
    (word
      "Encounters exported to "
      output-file
    )
end

to export-trip-results

  let output-file
    (word
      "outputs/trip_results_run_"
      run-id
      ".csv"
    )

  file-close-all

  if file-exists? output-file [
    file-delete output-file
  ]

  file-open output-file

  file-print
    (word
      "run_id,"
      "seed,"
      "demand_factor,"
      "mode,"
      "origin_zone,"
      "destination_zone,"
      "flow_slot,"
      "scheduled_spawn_time_s,"
      "arrival_time_s,"
      "trajectory_duration_min,"
      "average_speed_kmh,"
      "trajectory_distance_km,"
      "congestion_duration_min,"
      "low_speed_duration_min,"
      "intermediate_speed_duration_min,"
      "high_speed_duration_min,"
      "copresence_car_percentage,"
      "copresence_bike_percentage,"
      "copresence_pedestrian_percentage"
    )

  foreach completed-trip-metrics [
    record ->

    file-print
      (word
        run-id ","
        run-seed ","
        run-demand-factor ","
        item 0 record ","
        item 11 record ","
        item 12 record ","
        item 13 record ","
        precision (item 14 record) 3 ","
        precision (item 15 record) 3 ","
        precision (item 1 record) 6 ","
        precision (item 2 record) 6 ","
        precision (item 3 record) 6 ","
        precision (item 4 record) 6 ","
        precision (item 5 record) 6 ","
        precision (item 6 record) 6 ","
        precision (item 7 record) 6 ","
        precision (100 * item 8 record) 6 ","
        precision (100 * item 9 record) 6 ","
        precision (100 * item 10 record) 6
      )
  ]

  file-close

  show (word
    "Trip results exported to "
    output-file
  )
end

to export-simulation-summary

  let output-file
    (word
      "outputs/simulation_summary_run_"
      run-id
      ".csv"
    )

  file-close-all

  if file-exists? output-file [
    file-delete output-file
  ]

  file-open output-file

  file-print
    (word
      "run_id,"
      "seed,"
      "demand_factor,"
      "start_slot,"
      "start_time,"
      "configured_duration_min,"
      "actual_end_time_s,"
      "run_status,"
      "run_time_limit_s,"
      "active_agents_total,"
      "pending_entries_total,"
      "mode,"
      "generated_agents_total,"
      "completed_trips,"
      "failed_paths_total,"
      "mean_duration_min,"
      "mean_speed_kmh,"
      "mean_distance_km,"
      "mean_congestion_min,"
      "mean_low_speed_min,"
      "mean_intermediate_speed_min,"
      "mean_high_speed_min,"
      "mean_copresence_car_percentage,"
      "mean_copresence_bike_percentage,"
      "mean_copresence_pedestrian_percentage"
    )

  let transport-modes
    ["all" "car" "bike" "pedestrian"]

  foreach transport-modes [
    transport-mode ->

    file-print
      (word
        run-id ","
        run-seed ","
        run-demand-factor ","
        selected-flow-slot ","
        slot-start-time selected-flow-slot ","
        simulation-duration-minutes ","
        precision sim-time-seconds 3 ","
        real-flow-run-status ","
        precision run-time-limit-seconds 3 ","
        (count mobile-agents) ","
        (length scheduled-trips) ","
        transport-mode ","
        generated-vehicles ","
        completed-trip-count-by-mode transport-mode ","
        failed-paths ","
        precision
          (average-trajectory-duration-min transport-mode)
          6 ","
        precision
          (average-trajectory-speed-kmh transport-mode)
          6 ","
        precision
          (average-trajectory-distance-km transport-mode)
          6 ","
        precision
          (average-congestion-duration-min transport-mode)
          6 ","
        precision
          (average-low-speed-duration-min transport-mode)
          6 ","
        precision
          (average-intermediate-speed-duration-min transport-mode)
          6 ","
        precision
          (average-high-speed-duration-min transport-mode)
          6 ","
        precision
          (average-copresence-car-percentage transport-mode)
          6 ","
        precision
          (average-copresence-bike-percentage transport-mode)
          6 ","
        precision
          (average-copresence-pedestrian-percentage transport-mode)
          6
      )
  ]

  file-close

  show (word
    "Simulation summary exported to "
    output-file
  )
end]]></code>
