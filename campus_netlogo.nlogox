to-report indicator-values [indicator-name transport-mode]

  let records completed-trip-records-by-mode transport-mode

  if indicator-name = "duration" [
    report map [r -> item 1 r] records
  ]

  if indicator-name = "speed" [
    report map [r -> item 2 r] records
  ]

  if indicator-name = "distance" [
    report map [r -> item 3 r] records
  ]

  if indicator-name = "congestion" [
    report map [r -> item 4 r] records
  ]

  if indicator-name = "low-speed-duration" [
    report map [r -> item 5 r] records
  ]

  if indicator-name = "intermediate-speed-duration" [
    report map [r -> item 6 r] records
  ]

  if indicator-name = "high-speed-duration" [
    report map [r -> item 7 r] records
  ]

  if indicator-name = "copresence-car" [
    set records filter [
      r -> item 0 r != "car"
    ] records
    report map [
      r -> 100 * item 8 r
    ] records
  ]

  if indicator-name = "copresence-bike" [
    set records filter [
      r -> item 0 r != "bike"
    ] records
    report map [
      r -> 100 * item 9 r
    ] records
  ]

  if indicator-name = "copresence-pedestrian" [
    set records filter [
      r -> item 0 r != "pedestrian"
    ] records
    report map [
      r -> 100 * item 10 r
    ] records
  ]

  report []
end

to-report selected-indicator-values

  if selected-indicator = "copresence" [

    if copresence-target = "car" [
      report indicator-values "copresence-car" plot-mode
    ]

    if copresence-target = "bike" [
      report indicator-values "copresence-bike" plot-mode
    ]

    report indicator-values "copresence-pedestrian" plot-mode
  ]

  report indicator-values selected-indicator plot-mode
end

to-report mean-or-zero [values]
  if empty? values [
    report 0
  ]

  report mean values
end

to-report last-n-values [values number-of-values]

  if empty? values [
    report []
  ]

  let n max (list 1 floor number-of-values)

  if length values <= n [
    report values
  ]

  report sublist values (length values - n) length values
end

to-report histogram-interval-for [values]

  if empty? values [
    report 1
  ]

  if length values = 1 [
    report 1
  ]

  let minimum-value min values
  let maximum-value max values

  let value-range
    maximum-value - minimum-value

  if value-range <= 0 [
    report 1
  ]

  let number-of-bins
    round sqrt length values

  set number-of-bins
    max (list 5 number-of-bins)

  set number-of-bins
    min (list 15 number-of-bins)

  report value-range / number-of-bins
end
 
to-report current-plot-signature
  report (word
    selected-indicator "|"
    plot-view "|"
    plot-mode "|"
    copresence-target "|"
    sliding-window-size)
end

to update-indicator-plot

  set-current-plot "Indicator plot"

  let signature current-plot-signature

  if signature != last-plot-signature [
    clear-plot
    set last-plot-signature signature
  ]

  let values selected-indicator-values
  let time-min sim-time-seconds / 60

  if plot-view = "mean" [
    set-current-plot-pen "value"
    set-plot-pen-mode 0

    plotxy time-min (mean-or-zero values)
  ]

  if plot-view = "sliding" [
    let sliding-values
      last-n-values values sliding-window-size

    set-current-plot-pen "value"
    set-plot-pen-mode 0

    plotxy time-min (mean-or-zero sliding-values)
  ]

  if plot-view = "histogram" [
    clear-plot
    set-current-plot-pen "value"
    set-plot-pen-mode 1
    
    if not empty? values [
      set-plot-pen-interval histogram-interval-for values
      histogram values
    ]
  ]

end

to-report selected-indicator-mean
  report mean-or-zero selected-indicator-values
end

to-report selected-indicator-unit

  if selected-indicator = "speed" [
    report "km/h"
  ]

  if selected-indicator = "distance" [
    report "km"
  ]

  if selected-indicator = "copresence" [
    report "%"
  ]

  report "min"
end

to clear-encounter-heatmap-core

  ask patches [
    set encounter-count 0
    set pcolor white
  ]

end

to export-encounter-heatmap

  if show-encounter-heatmap? [
    update-encounter-heatmap
  ]

  display

  export-view
    (word "outputs/encounter_heatmap_run_" run-id ".png")

  show (word
    "Encounter heatmap exported to outputs/encounter_heatmap_run_"
    run-id
    ".png"
  )

end

to run-multiple-simulations

  let total-runs max (list 1 (round number-of-runs))
  let base-seed experiment-seed

  if base-seed != floor base-seed or
     base-seed < 0 or
     (base-seed + total-runs - 1) > 2147483647 [
    error "La semilla inicial y las semillas del lote deben estar entre 0 y 2147483647."
  ]

  let current-batch-run 1

  show (word
    "Starting batch of " total-runs
    " simulations. Seeds: " base-seed
    " to " (base-seed + total-runs - 1)
  )

  carefully [

    no-display

    while [current-batch-run <= total-runs] [

      set experiment-seed
        base-seed + current-batch-run - 1

      show (word
        "Preparing batch simulation "
        current-batch-run " of " total-runs
        " | seed: " experiment-seed
      )

      setup-real-flow-simulation

      show (word
        "Running simulation with run-id " run-id
        " | seed: " run-seed
      )

      while [not real-flow-run-ended?] [
        go-real-flow-step
      ]

      finish-real-flow-run

      show (word
        "Processed batch simulation "
        current-batch-run " of " total-runs
        " | seed: " run-seed
        " | status: " real-flow-run-status
      )

      set current-batch-run current-batch-run + 1
    ]

  ] [
    set experiment-seed base-seed
    display
    error error-message
  ]

  set experiment-seed base-seed
  display

  user-message (word
    total-runs
    " simulations processed and exported. Check run_status. Seeds: "
    base-seed " to " (base-seed + total-runs - 1)
  )
end

to finish-real-flow-run
  if not real-flow-run-ended? [
    error "La ejecucion sigue en curso; no puede finalizarse."
  ]

  if not results-exported? [
    close-all-active-encounters

    if show-encounter-heatmap? [
      update-encounter-heatmap
      export-encounter-heatmap
    ]

    export-trip-results
    export-simulation-summary
    export-encounters

    set results-exported? true

    show (word
      "Run " run-id
      " | status: " real-flow-run-status
      " | completed: " completed-trips
      " | active: " count mobile-agents
      " | pending: " length scheduled-trips
      " | exported."
    )
  ]
end

to go-real-flow-step
  if results-exported? or real-flow-run-ended? [
    stop
  ]

  generate-scheduled-real-agents
  update-copresence-times
  update-encounters
  update.mobile-agent.speed
  move.mobile-agents
  update-speed-duration-times

  set sim-time-seconds sim-time-seconds + seconds-per-tick
  finish-arrived-trips

  update-indicator-plot

  if show-encounter-heatmap? [
    if ticks mod 25 = 0 [
      update-encounter-heatmap
    ]
  ]

  tick
end

to go-real-flow
  if results-exported? [
    stop
  ]

  if not real-flow-run-ended? [
    go-real-flow-step
  ]

  if real-flow-run-ended? [
    finish-real-flow-run

    user-message (word
      "Run " run-id
      " | status: " real-flow-run-status
      " | completed trips: " completed-trips
      " | active agents: " count mobile-agents
      " | pending entries: " length scheduled-trips
    )

    stop
  ]
end

