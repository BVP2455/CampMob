<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[extensions [ gis csv ]

globals 
[ 
  scale-dataset
  buildings
  roads
  zones
  footway
  motorway
  pedestrianway
  bicycleway

  nodes-dataset
  edges-dataset
  
  origin-point
  destination-point
  selected-path
  
  sim-time-seconds
  seconds-per-tick
  meters-per-netlogo-unit
  
  vehicle-safety-distance
  intersection-safety-distance
  movement-step-size
  
  simulation-duration-seconds
  last-vehicle-generation-time
  generated-vehicles
  completed-trips
  failed-paths
  
  right-priority-radius
  roundabout-priority-radius
  deadlock-release-time
  
  route-pool
  route-pool-target-size
  
  flow-zones-dataset
  flow-zone-radius
  flow-counts
  scheduled-trips
  outflow-usage
  flow-slot-duration-seconds
  real-route-cache
  completed-trip-metrics
  copresence-distance-car-m
  copresence-distance-bike-m
  copresence-distance-pedestrian-m
  last-plot-signature
  run-id
  results-exported?
  
  encounter-distance-m
  active-encounters
  completed-encounters
  next-encounter-id
  bike-walking-distance-total-m
  run-seed
  run-time-limit-seconds
  run-demand-factor
  gis-endpoint-audit
  gis-created-endpoint-nodes
  gis-max-endpoint-offset-m
]

breed [ vehicles vehicle ]
breed [ pedestrians pedestrian ]
breed [ bicycles bicycle ]

breed [ nodes node ]
breed [ waypoints waypoint ]
directed-link-breed [ edges edge ]
breed [ flow-zones flow-zone ]

patches-own [
  encounter-count
]

nodes-own [
  node-id
  lane-direction
  node-key
  dist
  previous
  visited?
  intersection?
  roundabout-node?
]

waypoints-own [
  lane-direction
  road-id
  dist
  previous
  visited?
]

flow-zones-own [
  zone-id
  zone-radius

  pedestrian-in-nodes
  pedestrian-out-nodes

  bike-in-nodes
  bike-out-nodes

  car-in-nodes
  car-out-nodes
]

edges-own [
  road-type
  road-length
  edge-road-id
  allowed-modes
  roundabout?
]

turtles-own [
  bike-route-walk-cost
  current-node
  next-node
  previous-node
  destination-node
  path
  speed
  speed-factor
  arrived?
  stopped?
  roundabout-inside?
  agent-mode
  waiting-time
  origin-zone-id
  destination-zone-id
  scheduled-spawn-time
  flow-slot-id
  trip-start-time
  trip-distance-m
  total-congestion-time
  distance-moved-this-tick
  low-speed-time
  intermediate-speed-time
  high-speed-time
  copresence-time-car
  copresence-time-bike
  copresence-time-pedestrian
]

vehicles-own [
]

bicycles-own [
]

to setup
  let requested-seed experiment-seed
  
  let requested-demand-factor demand-factor

  if not member? requested-demand-factor [1 2 3] [
    error "El factor de demanda debe ser 1, 2 o 3."
  ]

  if requested-seed != floor requested-seed or
     requested-seed < 0 or
     requested-seed > 2147483647 [
    error "La semilla debe ser un entero entre 0 y 2147483647."
  ]

  clear-all

  set run-demand-factor requested-demand-factor
  set run-seed requested-seed
  random-seed run-seed

  show (word "Simulation seed: " run-seed)
  
  set origin-point nobody
  set destination-point nobody
  set selected-path []

  set sim-time-seconds 0
  set seconds-per-tick 0.2
  set meters-per-netlogo-unit 21.39540387800133
  
  set vehicle-safety-distance 0.12
  set intersection-safety-distance 0.10
  set movement-step-size 0.03
  
  set simulation-duration-seconds simulation-duration-minutes * 60
  set run-time-limit-seconds simulation-duration-seconds + 3600
  set last-vehicle-generation-time (- vehicle-generation-interval-seconds)
  set generated-vehicles 0
  set bike-walking-distance-total-m 0
  set completed-trips 0
  set failed-paths 0
  
  set right-priority-radius 0.30
  set roundabout-priority-radius 0.35
  set deadlock-release-time 4
  
  set route-pool []
  set route-pool-target-size 25
  
  set flow-zone-radius 0.35
  set flow-counts []
  set scheduled-trips []
  set outflow-usage []
  set flow-slot-duration-seconds 900
  set real-route-cache []
  set completed-trip-metrics []
  
  set copresence-distance-car-m 5
  set copresence-distance-bike-m 3
  set copresence-distance-pedestrian-m 2
  set last-plot-signature ""
  set run-id next-available-run-id
  set results-exported? false
  set encounter-distance-m 5
  set active-encounters []
  set completed-encounters []
  set next-encounter-id 1
  
  ask patches [
    set encounter-count 0
  ]
  
  load-gis
  draw-gis
  load-graph-from-shp
  reset-ticks
end

to load-gis
  set buildings gis:load-dataset "data/10731/buildings_gross.shp"
  set roads gis:load-dataset "data/10731/Roads_gross.shp"
  set zones gis:load-dataset "data/10731/zone.shp"
  set nodes-dataset gis:load-dataset "data/10731/Netlogo_nodes.shp"
  set edges-dataset gis:load-dataset "data/10731/osmRoads.shp"

  gis:set-world-envelope
    (gis:envelope-union-of
      (gis:envelope-of zones)
      (gis:envelope-of nodes-dataset)
      (gis:envelope-of edges-dataset)
    )
end

to draw-gis
  ask patches [
    set pcolor white
  ]
  

  gis:set-drawing-color green
  gis:draw zones 5

  gis:set-drawing-color gray
  gis:fill buildings 1

  gis:set-drawing-color black
  gis:draw buildings 1

end

to load-graph-from-shp
  set gis-created-endpoint-nodes 0
  set gis-max-endpoint-offset-m 0

  load-nodes
  load-full-edges-by-geometry
  create-turn-connectors
  identify-traffic-nodes

  show (word
    "GRAFO | nodos de extremo añadidos: "
    gis-created-endpoint-nodes
    " | desplazamiento maximo de extremos m: "
    precision gis-max-endpoint-offset-m 6
  )
end

to-report mobile-agents
  report (turtle-set vehicles bicycles pedestrians)
end

to setup-mobile-agent [mode origin destination new-path]
  set agent-mode mode
  set current-node origin
  move-to current-node
  set destination-node destination
  set path new-path
  set previous-node nobody
  set next-node nobody
  set speed-factor bounded-random-normal 1 0.15 0.6 1.4
  set speed kmh-to-netlogo-speed (speed-kmh-from-mode mode * speed-factor)
  set stopped? false
  set arrived? false
  set roundabout-inside? false
  set waiting-time 0
  set origin-zone-id ""
  set destination-zone-id ""
  set scheduled-spawn-time -1
  set flow-slot-id -1
  set trip-start-time sim-time-seconds
  set trip-distance-m 0
  set total-congestion-time 0
  set distance-moved-this-tick 0
  set low-speed-time 0
  set intermediate-speed-time 0
  set high-speed-time 0
  set copresence-time-car 0
  set copresence-time-bike 0
  set copresence-time-pedestrian 0
end

to-report next-available-run-id
  let candidate 1

  while [
    file-exists?
      (word "outputs/trip_results_run_" candidate ".csv")
    or
    file-exists?
      (word "outputs/simulation_summary_run_" candidate ".csv")
    or
    file-exists?
      (word "outputs/encounters_run_" candidate ".csv")
  ] [
    set candidate candidate + 1
  ]

  report candidate
end

to-report speed-kmh-from-mode [mode]
  if mode = "car" [ report vehicle-speed-kmh ]
  if mode = "bike" [ report 15 ]
  if mode = "pedestrian" [ report 5 ]
  report vehicle-speed-kmh
end

to create-mobile-agent [mode origin destination new-path]
  if mode = "car" [
    create-vehicles 1 [
      set color yellow
      set size 0.5
      set shape "car"
      setup-mobile-agent mode origin destination new-path
    ]
    stop
  ]

  if mode = "bike" [
    create-bicycles 1 [
      set color pink
      set size 0.5
      set shape "wheel"
      setup-mobile-agent mode origin destination new-path
    ]
    stop
  ]

  if mode = "pedestrian" [
    create-pedestrians 1 [
      set color orange
      set size 0.3
      set shape "person"
      setup-mobile-agent mode origin destination new-path
    ]
    stop
  ]
end

to identify-traffic-nodes
  let junction-keys
    sort (remove-duplicates [node-key] of nodes)

  foreach junction-keys [junction-key ->
    let junction-nodes nodes with [
      node-key = junction-key
    ]

    let incoming no-links
    let outgoing no-links

    foreach sort junction-nodes [junction-node ->
      set incoming
        (link-set incoming ([my-in-edges] of junction-node))

      set outgoing
        (link-set outgoing ([my-out-edges] of junction-node))
    ]

    set incoming incoming with [road-type != "turn"]
    set outgoing outgoing with [road-type != "turn"]

    let junction-intersection?
      ((count incoming + count outgoing) >= 3)

    let junction-roundabout?
      ((any? incoming with [roundabout?]) or
       (any? outgoing with [roundabout?]))

    ask junction-nodes [
      set intersection? junction-intersection?
      set roundabout-node? junction-roundabout?

      set size 0.08

      if intersection? [
        set size 0.11
      ]

      if roundabout-node? [
        set size 0.13
      ]
    ]
  ]
end

to load-nodes
  let id-counter 0

  foreach gis:feature-list-of nodes-dataset [
    feat ->

    let coords gis:location-of (first (first (gis:vertex-lists-of feat)))

    if not empty? coords [
      let k coord-key coords

      create-nodes 1 [
        set node-id id-counter
        set node-key k
        set lane-direction "forward"
        setxy item 0 coords item 1 coords
        set color cyan
        set size 0.08
        set shape "circle"
      ]

      create-nodes 1 [
        set node-id id-counter
        set node-key k
        set lane-direction "backward"
        setxy item 0 coords item 1 coords
        set color blue
        set size 0.08
        set shape "circle"
      ]

      set id-counter id-counter + 1
    ]
  ]
end

to load-full-edges-by-geometry
  foreach gis:feature-list-of edges-dataset [
    feat ->
    
    let mode allowed-modes-from-feature feat
    let direction-value word gis:property-value feat "ONEWAY_" ""
    let round-value word gis:property-value feat "ISROUND_" ""
    let current-road-id gis:property-value feat "ID_"

    foreach gis:vertex-lists-of feat [
      vlist ->

      let loc-list []

      foreach vlist [
        v ->
        let loc gis:location-of v

        if not empty? loc [
          set loc-list lput loc loc-list
        ]
      ]

      set loc-list remove-consecutive-duplicate-locations loc-list
      if length loc-list >= 2 [

        ifelse round-value = "true" [
          create-road-path loc-list current-road-id "forward" "roundabout" mode
        ]
        [
          if direction-value = "yes" [
            create-road-path loc-list current-road-id "forward" "oneway" mode
          ]

          if direction-value = "" or direction-value = "no" [
            create-road-path loc-list current-road-id "forward" "two-way-forward" mode
            create-road-path reverse loc-list current-road-id "backward" "two-way-backward" mode
          ]
        ]
      ]
    ]
  ]
end

to create-road-path [loc-list current-road-id lane-dir link-type mode]

  let previous-agent nobody
  let i 0

  foreach loc-list [
    loc ->

    let current-agent nobody

    ifelse i = 0 or i = (length loc-list - 1)
    [
      set current-agent node-at-location loc lane-dir
    ]
    [
      create-waypoints 1 [
        setxy item 0 loc item 1 loc
        set lane-direction lane-dir
        set road-id current-road-id
        set color gray
        set size 0.06
        set shape "circle"
        set current-agent self
      ]
    ]

    if previous-agent != nobody and current-agent != nobody [
      connect-graph-agents previous-agent current-agent link-type current-road-id mode
    ]

    set previous-agent current-agent
    set i i + 1
  ]
end

to connect-graph-agents [a b link-type current-road-id mode]

  if a = nobody or b = nobody [
    stop
  ]

  if a = b [
    show (word
      "Skipped self-link in road " current-road-id
      " | agent: " a
      " | type: " link-type
    )
    stop
  ]

  let d [distance b] of a

  if d <= 0.000001 [
    show (word
      "Skipped zero-length edge in road " current-road-id
      " | distance: " d
    )
    stop
  ]

  ask a [
    if not out-link-neighbor? b [
      create-edge-to b [
        set color edge-color-from-modes mode
        set thickness 0.012
        set road-type link-type
        set edge-road-id current-road-id
        set road-length d
        set allowed-modes mode
        set roundabout? link-type = "roundabout"
      ]
    ]
  ]
end

to-report remove-consecutive-duplicate-locations [locations]
  if empty? locations [
    report []
  ]

  let cleaned (list first locations)
  let previous-location first locations

  foreach but-first locations [
    current-location ->

    let x (item 0 current-location) - (item 0 previous-location)
    let y (item 1 current-location) - (item 1 previous-location)
    let separation sqrt ((x * x) + (y * y))

    if separation > 0.000001 [
      set cleaned lput current-location cleaned
      set previous-location current-location
    ]
  ]

  report cleaned
end

to-report flatten-modes [mode-lists]
  let result []

  foreach mode-lists [
    lst ->
    set result sentence result lst
  ]

  report remove-duplicates result
end

to-report common-modes [list-a list-b]
  let result []

  foreach list-a [
    m ->
    if member? m list-b [
      set result lput m result
    ]
  ]

  report remove-duplicates result
end

to-report allowed-modes-from-feature [feat]

  let type-value word gis:property-value feat "TYPE_" ""
  let category-value word gis:property-value feat "CATEGORY_" ""
  let is-bus-value word gis:property-value feat "ISOPBUS_" ""
  let bus-routes word gis:property-value feat "BUSRTS_" ""

  let mode []

  if type-value = "busway" or is-bus-value = "true" or bus-routes != "[]" [
    set mode lput "bus" mode
  ]

  if category-value = "road" and type-value != "busway" [
    set mode lput "car" mode
  ]

  if category-value = "cycleway" [
    set mode lput "bike" mode
  ]

  if category-value = "pedestrian" or
     type-value = "footway" or
     type-value = "path" or
     type-value = "steps" or
     type-value = "platform" [
    set mode lput "pedestrian" mode
  ]

  if empty? mode [
    set mode ["car"]
  ]
  
  if member? "bike" mode or
     (category-value = "pedestrian" and
      member? type-value ["footway" "path"]) [
    set mode lput "bike-mixed" mode
  ]

  report remove-duplicates mode
end

to-report edge-color-from-modes [mode]
  
  set mode remove "bike-mixed" mode

  if member? "bus" mode and not member? "car" mode and not member? "bike" mode and not member? "pedestrian" mode [
    report blue
  ]

  if member? "bike" mode and not member? "car" mode and not member? "bus" mode and not member? "pedestrian" mode [
    report pink
  ]

  if member? "pedestrian" mode and not member? "car" mode and not member? "bus" mode and not member? "bike" mode [
    report orange
  ]

  if member? "car" mode and not member? "bus" mode and not member? "bike" mode and not member? "pedestrian" mode [
    report red
  ]

  if length mode > 1 [
    report violet
  ]

  report black
end

to create-turn-connectors

  ask edges with [road-type = "turn"] [
    die
  ]

  let keys remove-duplicates [node-key] of nodes

  foreach keys [
    k ->

    let intersection-nodes nodes with [
      node-key = k
    ]

    let arrival-nodes intersection-nodes with [
      any? my-in-edges with [road-type != "turn"]
    ]

    let departure-nodes intersection-nodes with [
      any? my-out-edges with [road-type != "turn"]
    ]

    ask arrival-nodes [
      let arrival self

      let arrival-modes flatten-modes [allowed-modes] of my-in-edges with [
        road-type != "turn"
      ]

      ask departure-nodes with [self != arrival] [
        let departure self

        let departure-modes flatten-modes [allowed-modes] of my-out-edges with [
          road-type != "turn"
        ]

        let turn-modes common-modes arrival-modes departure-modes

        if not empty? turn-modes [
          ask arrival [
            if not out-link-neighbor? departure [
              create-edge-to departure [
                set color edge-color-from-modes turn-modes
                set thickness 0.008
                set road-type "turn"
                set edge-road-id "turn"
                set road-length 0.01
                set allowed-modes turn-modes
                set roundabout? false
              ]
            ]
          ]
        ]
      ]
    ]
  ]
end

to-report coord-key [loc]
  let x item 0 loc
  let y item 1 loc
  report (word precision x 6 "," precision y 6)
end

to-report node-at-location [loc lane-dir]
  let k coord-key loc
  let location-x item 0 loc
  let location-y item 1 loc

  let candidates nodes with [
    node-key = k and
    lane-direction = lane-dir
  ]

  if any? candidates [
    let selected-node one-of candidates

    let offset-m
      ([distancexy location-x location-y] of selected-node) *
      meters-per-netlogo-unit

    set gis-max-endpoint-offset-m
      max (list gis-max-endpoint-offset-m offset-m)

    report selected-node
  ]

  let new-node nobody
  let new-node-id 0

  if any? nodes [
    set new-node-id 1 + max [node-id] of nodes
  ]

  create-nodes 1 [
    set node-id new-node-id
    set node-key k
    set lane-direction lane-dir

    setxy location-x location-y

    set color cyan
    if lane-dir = "backward" [
      set color blue
    ]

    set size 0.08
    set shape "circle"

    set intersection? false
    set roundabout-node? false

    set new-node self
  ]

  set gis-created-endpoint-nodes
    gis-created-endpoint-nodes + 1

  report new-node
end

to create.vehicles
  let valid-start-points (turtle-set nodes waypoints) with [
    any? my-out-edges with [
      member? "car" allowed-modes
    ]
  ]

  if not any? valid-start-points [
    user-message "No hay puntos con links salientes. Revisa la creación de edges."
    stop
  ]

  create-vehicles number-of-vehicles [
    set color yellow
    set size 0.5
    set shape "car"
    set agent-mode "car"
    set roundabout-inside? false

    set current-node one-of valid-start-points
    move-to current-node

    set previous-node nobody
    set next-node nobody
    set destination-node nobody
    set path []
    
    set speed-factor bounded-random-normal 1 0.15 0.6 1.4
    set speed kmh-to-netlogo-speed (vehicle-speed-kmh * speed-factor)
    set arrived? false
    set stopped? false
    set waiting-time 0
  ]
end

to update-speed-duration-times-core
  ask mobile-agents [

    let moved-meters
      distance-moved-this-tick * meters-per-netlogo-unit

    let actual-speed-kmh
      (moved-meters / seconds-per-tick) * 3.6

    ifelse actual-speed-kmh <= 0.0001 [
      set total-congestion-time
        total-congestion-time + seconds-per-tick
    ]
    [
      let low-limit
        low-speed-upper-limit agent-mode

      let intermediate-limit
        intermediate-speed-upper-limit agent-mode

      ifelse actual-speed-kmh <= low-limit [
        set low-speed-time
          low-speed-time + seconds-per-tick
      ]
      [
        ifelse actual-speed-kmh <= intermediate-limit [
          set intermediate-speed-time
            intermediate-speed-time + seconds-per-tick
        ]
        [
          set high-speed-time
            high-speed-time + seconds-per-tick
        ]
      ]
    ]
  ]
end

to update-copresence-times-core
  ask mobile-agents [

    let my-mode agent-mode

    let car-radius
      copresence-distance-car-m / meters-per-netlogo-unit

    let bike-radius
      copresence-distance-bike-m / meters-per-netlogo-unit

    let pedestrian-radius
      copresence-distance-pedestrian-m / meters-per-netlogo-unit

    if my-mode != "car" [
      if any? other mobile-agents with [
        agent-mode = "car" and
        distance myself <= car-radius
      ] [
        set copresence-time-car
          copresence-time-car + seconds-per-tick
      ]
    ]

    if my-mode != "bike" [
      if any? other mobile-agents with [
        agent-mode = "bike" and
        distance myself <= bike-radius
      ] [
        set copresence-time-bike
          copresence-time-bike + seconds-per-tick
      ]
    ]

    if my-mode != "pedestrian" [
      if any? other mobile-agents with [
        agent-mode = "pedestrian" and
        distance myself <= pedestrian-radius
      ] [
        set copresence-time-pedestrian
          copresence-time-pedestrian + seconds-per-tick
      ]
    ]
  ]
end

to update-encounters-core

  let encounter-radius
    encounter-distance-m / meters-per-netlogo-unit

  ask mobile-agents [

    let agent-1 self

    ask other mobile-agents with [
      who > [who] of agent-1 and
      agent-mode != [agent-mode] of agent-1 and
      distance agent-1 <= encounter-radius
    ][

      let agent-2 self

      let agent-1-id [who] of agent-1
      let agent-2-id [who] of agent-2

      let current-distance-m
        (distance agent-1) * meters-per-netlogo-unit

      let midpoint-x
        (([xcor] of agent-1 + [xcor] of agent-2) / 2)

      let midpoint-y
        (([ycor] of agent-1 + [ycor] of agent-2) / 2)

      let existing-records filter [
        record ->
          item 1 record = agent-1-id and
          item 3 record = agent-2-id
      ] active-encounters

      ifelse empty? existing-records [

        let new-record
        (list
          next-encounter-id
          agent-1-id
          [agent-mode] of agent-1
          agent-2-id
          [agent-mode] of agent-2
          sim-time-seconds
          sim-time-seconds
          midpoint-x
          midpoint-y
          midpoint-x
          midpoint-y
          current-distance-m
        )

        set active-encounters
        lput new-record active-encounters
        
        register-encounter-on-heatmap midpoint-x midpoint-y

        set next-encounter-id next-encounter-id + 1
      ]
      [
        let old-record first existing-records
        let record-position
          position old-record active-encounters

        let updated-record
          replace-item 6 old-record sim-time-seconds

        set updated-record
          replace-item 9 updated-record midpoint-x

        set updated-record
          replace-item 10 updated-record midpoint-y

        if current-distance-m < item 11 updated-record [
          set updated-record
            replace-item 11 updated-record current-distance-m
        ]

        set active-encounters
          replace-item
            record-position
            active-encounters
            updated-record
      ]
    ]
  ]

  close-stale-encounters
end

to register-encounter-on-heatmap [x y]

  let encounter-patch patch x y

  if encounter-patch != nobody [
    ask encounter-patch [
      set encounter-count encounter-count + 1
    ]
  ]

end

to update-encounter-heatmap-core

  if not show-encounter-heatmap? [
    ask patches [
      set pcolor white
    ]
    stop
  ]

  let max-heatmap-count 20

  ask patches [

    ifelse encounter-count = 0 [
      set pcolor white
    ]
    [
      let limited-count
        min (list encounter-count max-heatmap-count)

      set pcolor
        scale-color red
          limited-count
          max-heatmap-count
          0
    ]
  ]

end

to close-stale-encounters

  let still-active []

  foreach active-encounters [
    record ->

    ifelse
      item 6 record <
      (sim-time-seconds - seconds-per-tick / 2)
    [
      complete-encounter
        record
        (item 6 record + seconds-per-tick)
    ]
    [
      set still-active
        lput record still-active
    ]
  ]

  set active-encounters still-active
end

to close-encounters-for-agent [departing-agent-id]
  let still-active []

  foreach active-encounters [record ->
    ifelse
      item 1 record = departing-agent-id or
      item 3 record = departing-agent-id
    [
      complete-encounter record sim-time-seconds
    ]
    [
      set still-active lput record still-active
    ]
  ]

  set active-encounters still-active
end

to close-all-active-encounters

  foreach active-encounters [
    record ->
      complete-encounter record sim-time-seconds
  ]

  set active-encounters []
end


to complete-encounter [active-record encounter-end-time]

  let encounter-start-time
    item 5 active-record

  let safe-end-time
    max
      (list
        encounter-end-time
        (encounter-start-time + seconds-per-tick)
      )

  let encounter-duration
    safe-end-time - encounter-start-time

  let completed-record
    (list
      item 0 active-record
      item 1 active-record
      item 2 active-record
      item 3 active-record
      item 4 active-record
      encounter-start-time
      safe-end-time
      encounter-duration
      item 7 active-record
      item 8 active-record
      item 9 active-record
      item 10 active-record
      item 11 active-record
    )

  set completed-encounters
    lput completed-record completed-encounters
end

to-report vehicle-ahead-on-same-segment? [target]

  let my-current current-node
  let my-target target
  let my-distance-to-target distance target

  report any? other mobile-agents with [
    current-node = my-current and
    next-node = my-target and
    distance my-target < my-distance-to-target and
    distance myself < vehicle-safety-distance
  ]
end

to-report target-node-busy? [target]
  report false
end

to-report vehicle-ahead-on-same-segment [target]

  let my-current current-node
  let my-target target
  let my-distance-to-target distance target

  let candidates other mobile-agents with [
    not arrived? and
    current-node = my-current and
    next-node = my-target and
    distance my-target < my-distance-to-target
  ]

  if not any? candidates [
    report nobody
  ]

  report min-one-of candidates [distance myself]
end

to-report adjusted-step-distance [desired-step target]
  let front-agent vehicle-ahead-on-same-segment target

  if front-agent = nobody [
    report desired-step
  ]

  let available-distance
    (distance front-agent) - vehicle-safety-distance

  if available-distance <= 0.000000001 [
    report 0
  ]

  report min (list desired-step available-distance)
end

to vehicle-arrive

  if destination-node != nobody [
    move-to destination-node
    set current-node destination-node
  ]

  let duration-seconds sim-time-seconds - trip-start-time

  if duration-seconds > 0 [
    let duration-min duration-seconds / 60
    let distance-km trip-distance-m / 1000
    let average-speed-kmh distance-km / (duration-seconds / 3600)
    let congestion-min total-congestion-time / 60
    let low-speed-min low-speed-time / 60
    let intermediate-speed-min intermediate-speed-time / 60
    let high-speed-min high-speed-time / 60
    let copresence-car-ratio copresence-time-car / duration-seconds
    let copresence-bike-ratio copresence-time-bike / duration-seconds
    let copresence-pedestrian-ratio copresence-time-pedestrian / duration-seconds

    set completed-trip-metrics lput
      (list
        agent-mode
        duration-min
        average-speed-kmh
        distance-km
        congestion-min
        low-speed-min
        intermediate-speed-min
        high-speed-min
        copresence-car-ratio
        copresence-bike-ratio
        copresence-pedestrian-ratio
        origin-zone-id
        destination-zone-id
        flow-slot-id
        scheduled-spawn-time
        sim-time-seconds
      )
      completed-trip-metrics
  ]

  set completed-trips completed-trips + 1
  close-encounters-for-agent who
  die
end

to-report average-congestion-duration-min [transport-mode]
  let records
    completed-trip-records-by-mode transport-mode

  if empty? records [
    report 0
  ]

  report mean map [
    r -> item 4 r
  ] records
end

to-report average-low-speed-duration-min [transport-mode]
  let records completed-trip-records-by-mode transport-mode

  if empty? records [
    report 0
  ]

  report mean map [r -> item 5 r] records
end

to-report average-intermediate-speed-duration-min [transport-mode]
  let records completed-trip-records-by-mode transport-mode

  if empty? records [
    report 0
  ]

  report mean map [r -> item 6 r] records
end

to-report average-high-speed-duration-min [transport-mode]
  let records completed-trip-records-by-mode transport-mode

  if empty? records [
    report 0
  ]

  report mean map [r -> item 7 r] records
end

to-report average-copresence-car-percentage [transport-mode]

  let records completed-trip-records-by-mode transport-mode

  set records filter [
    r -> item 0 r != "car"
  ] records

  if empty? records [
    report 0
  ]

  report 100 * mean map [
    r -> item 8 r
  ] records
end

to-report average-copresence-bike-percentage [transport-mode]

  let records completed-trip-records-by-mode transport-mode

  set records filter [
    r -> item 0 r != "bike"
  ] records

  if empty? records [
    report 0
  ]

  report 100 * mean map [
    r -> item 9 r
  ] records
end

to-report average-copresence-pedestrian-percentage [transport-mode]

  let records completed-trip-records-by-mode transport-mode

  set records filter [
    r -> item 0 r != "pedestrian"
  ] records

  if empty? records [
    report 0
  ]

  report 100 * mean map [
    r -> item 10 r
  ] records
end

to-report classified-duration-total-min [transport-mode]
  report
    average-congestion-duration-min transport-mode +
    average-low-speed-duration-min transport-mode +
    average-intermediate-speed-duration-min transport-mode +
    average-high-speed-duration-min transport-mode
end

to-report position-blocked? [move-distance]
  let front-agent vehicle-ahead-on-same-segment next-node

  if front-agent = nobody [
    report false
  ]

  let available-distance
    max (list
      0
      ((distance front-agent) - vehicle-safety-distance)
    )

  report move-distance > available-distance + 0.000000001
end

to-report on-roundabout?
  report roundabout-inside? = true
end

to-report roundabout-entry-point [target]
  if current-node = nobody or target = nobody [
    report nobody
  ]

  let origin current-node
  let first-edge one-of [my-out-edges with [
    end2 = target
  ]] of origin

  if first-edge = nobody [
    report nobody
  ]

  if [roundabout?] of first-edge [
    report origin
  ]

  let cursor target
  let remaining-path path

  if not is-list? remaining-path [
    report nobody
  ]

  while [not empty? remaining-path] [
    let following-point first remaining-path
    set remaining-path but-first remaining-path

    let route-edge one-of [my-out-edges with [
      end2 = following-point
    ]] of cursor

    if route-edge = nobody [
      report nobody
    ]

    if [roundabout?] of route-edge [
      report cursor
    ]

    if [road-type] of route-edge != "turn" [
      report nobody
    ]

    set cursor following-point
  ]

  report nobody
end

to-report next-edge-roundabout? [target]
  let my-current current-node

  if my-current = nobody or target = nobody [
    report false
  ]

  report any? edges with [
    roundabout? and
    end1 = my-current and
    end2 = target
  ]
end

to-report roundabout-entry-blocked? [target]
  if waiting-time >= deadlock-release-time [
    report false
  ]

  if on-roundabout? [
    report false
  ]

  let entry-point roundabout-entry-point target

  if entry-point = nobody [
    report false
  ]

  if distance entry-point > roundabout-priority-radius [
    report false
  ]

  report any? other mobile-agents with [
    not arrived? and
    on-roundabout? and
    distance entry-point < roundabout-priority-radius
  ]
end

to update-roundabout-state-after-move
  if current-node = nobody or next-node = nobody [
    stop
  ]

  let target next-node

  let traversed-edge one-of [my-out-edges with [
    end2 = target
  ]] of current-node

  if traversed-edge != nobody [
    if [road-type] of traversed-edge != "turn" [
      set roundabout-inside? [roundabout?] of traversed-edge
    ]
  ]
end

to-report has-priority-over-me? [other-car target]

  let my-wait waiting-time
  let my-distance distance target

  let other-wait [waiting-time] of other-car
  let other-distance [distance target] of other-car

  if other-wait > my-wait + 0.5 [
    report true
  ]

  if abs (other-wait - my-wait) <= 0.5 and other-distance < my-distance [
    report true
  ]

  report false
end

to-report vehicle-from-right-near? [target]
  if target = nobody [
    report false
  ]

  if [breed] of target != nodes [
    report false
  ]

  if distance target > right-priority-radius [
    report false
  ]

  let junction-key [node-key] of target

  let equivalent-targets nodes with [
    node-key = junction-key
  ]

  let my-x xcor
  let my-y ycor
  let right-heading (heading + 90) mod 360

  let blockers other mobile-agents with [
    not arrived? and
    next-node != nobody
  ]

  set blockers blockers with [
    member? next-node equivalent-targets and
    distance target < right-priority-radius
  ]

  set blockers blockers with [
    xcor != my-x or ycor != my-y
  ]

  set blockers blockers with [
    abs (
      subtract-headings
        (atan (xcor - my-x) (ycor - my-y))
        right-heading
    ) < 70
  ]

  let blocked? false

  foreach sort blockers [other-agent ->
    if has-priority-over-me? other-agent target [
      set blocked? true
    ]
  ]

  report blocked?
end

to-report traffic-priority-blocked? [target]
  
  if agent-mode = "pedestrian" or bike-walking-on-edge? target [
    report false
  ]

  if target = nobody [
    report false
  ]

  if waiting-time >= deadlock-release-time [
    report false
  ]

  if roundabout-entry-blocked? target [
    report true
  ]

  if [breed] of target = nodes [
    if [intersection?] of target and not [roundabout-node?] of target [
      if vehicle-from-right-near? target [
        report true
      ]
    ]
  ]

  report false
end

to-report bounded-random-normal [mean-value sd-value min-value max-value]
  let value random-normal mean-value sd-value

  if value < min-value [
    set value min-value
  ]

  if value > max-value [
    set value max-value
  ]

  report value
end

to move.mobile-agents
   ask mobile-agents [
    
    set distance-moved-this-tick 0

    ifelse arrived? [
      set color green
      set next-node nobody
      set path []
      set speed 0
    ]
    [

      set stopped? false

      if destination-node != nobody and current-node = destination-node [
        mark-trip-arrived
      ]

      if not arrived? [

        let remaining-distance speed
        let substeps 0
        let max-substeps 500

        while [remaining-distance > 0 and substeps < max-substeps and not arrived? and not stopped?] [

          set substeps substeps + 1

          if next-node = nobody [
            ifelse is-list? path and not empty? path [
              set next-node first path
              set path but-first path
            ]
            [
              if destination-node = nobody [
                
                let my-mode agent-mode

                let possible-links [my-out-edges with [
                  member? my-mode allowed-modes
                ]] of current-node
                
                if any? possible-links [
                  let chosen-link one-of possible-links
                  set next-node [end2] of chosen-link
                ]
              ]
            ]
          ]
          if next-node = nobody [
            set remaining-distance 0
          ]

          if next-node != nobody [

            let d distance next-node

            ifelse d < 0.0001 [

              ifelse target-node-busy? next-node [
                set stopped? true
                set color red
                set waiting-time waiting-time + seconds-per-tick
                set remaining-distance 0
              ]
              [
                set previous-node current-node
                set current-node next-node
                set next-node nobody
                set waiting-time 0

                if destination-node != nobody and current-node = destination-node [
                  mark-trip-arrived
                  set remaining-distance 0
                ]
              ]

            ]
            [
              face next-node
              let walking-now? bike-walking-on-edge? next-node
              let speed-ratio 1

              if walking-now? [
                let walking-speed kmh-to-netlogo-speed
                  (speed-kmh-from-mode "pedestrian" * speed-factor)

                set speed-ratio min (list 1 (walking-speed / speed))
              ]

              let desired-step-distance min(list(remaining-distance * speed-ratio) d movement-step-size)
              let step-distance adjusted-step-distance desired-step-distance next-node
              
              ifelse step-distance = 0 [
                set stopped? true
                set color red
                set waiting-time waiting-time + seconds-per-tick
                set remaining-distance 0
              ]
              [
                ifelse traffic-priority-blocked? next-node [
                  set stopped? true
                  set color red
                  set waiting-time waiting-time + seconds-per-tick
                  set remaining-distance 0
                ]
                [
                  ifelse position-blocked? step-distance [
                    set stopped? true
                    set color red
                    set waiting-time waiting-time + seconds-per-tick
                    set remaining-distance 0
                  ]
                  [
                    fd step-distance
                    update-roundabout-state-after-move
                    set distance-moved-this-tick distance-moved-this-tick + step-distance
                    set trip-distance-m trip-distance-m + (step-distance * meters-per-netlogo-unit)
                    set waiting-time 0
                    set remaining-distance max
                      (list
                        0
                        (remaining-distance - step-distance / speed-ratio)
                      )

                    if walking-now? [
                      set bike-walking-distance-total-m
                        bike-walking-distance-total-m +
                        (step-distance * meters-per-netlogo-unit)
                    ]
                    
                    if distance next-node < 0.0005 [
                      set previous-node current-node
                      set current-node next-node
                      set next-node nobody
                      
                      ifelse destination-node != nobody and current-node = destination-node [
                        mark-trip-arrived
                        set remaining-distance 0
                      ]
                      [
                        if color != green [
                          ifelse [breed] of current-node = waypoints [
                            set color violet
                          ]
                          [
                            set color yellow
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    ]
  ]
end

to mark-trip-arrived
  set arrived? true
  set next-node nobody
  set path []
end

to finish-arrived-trips
  foreach sort (mobile-agents with [arrived?]) [finished-agent ->
    ask finished-agent [
      vehicle-arrive
    ]
  ]
end

to-report preferred-bike-path [source-set target-set]

  if not any? source-set or not any? target-set [
    report []
  ]

  let goals target-set with [
    not member? self source-set
  ]

  if not any? goals [
    report []
  ]

  let graph-points (turtle-set nodes waypoints)

  ask graph-points [
    set bike-route-walk-cost 1.0E+30
    set dist 1.0E+30
    set previous nobody
    set visited? false
  ]

  ask source-set [
    set bike-route-walk-cost 0
    set dist 0
  ]

  let frontier source-set

  while [any? frontier] [

    let least-walking min [bike-route-walk-cost] of frontier

    let tied frontier with [
      bike-route-walk-cost = least-walking
    ]

    let current min-one-of tied [dist]

    set frontier frontier with [
      self != current
    ]

    if member? current goals [
      let full-route (list current)
      let cursor current

      while [[previous] of cursor != nobody] [
        set cursor [previous] of cursor
        set full-route fput cursor full-route
      ]

      report full-route
    ]

    ask current [
      set visited? true
    ]

    let permitted [
      my-out-edges with [
        member? "bike-mixed" allowed-modes
      ]
    ] of current

    ask permitted [

      let neighbor end2

      if not [visited?] of neighbor [

        let extra-walking 0

        if road-type != "turn" and
           not member? "bike" allowed-modes [
          set extra-walking road-length
        ]

        let candidate-walking
          ([bike-route-walk-cost] of current) + extra-walking

        let candidate-distance
          ([dist] of current) + road-length

        if candidate-walking < [bike-route-walk-cost] of neighbor or
           (candidate-walking = [bike-route-walk-cost] of neighbor and
            candidate-distance < [dist] of neighbor) [

          ask neighbor [
            set bike-route-walk-cost candidate-walking
            set dist candidate-distance
            set previous current
          ]

          set frontier (turtle-set frontier neighbor)
        ]
      ]
    ]
  ]

  report []
end

to-report bike-walking-on-edge? [target]

  if agent-mode != "bike" or
     current-node = nobody or
     target = nobody [
    report false
  ]

  let outgoing [my-out-edges] of current-node

  report any? outgoing with [
    end2 = target and
    road-type != "turn" and
    member? "bike-mixed" allowed-modes and
    not member? "bike" allowed-modes
  ]
end

to-report bike-path-walking-m [full-route]

  let walking-length 0

  if length full-route < 2 [
    report 0
  ]

  (foreach (but-last full-route) (but-first full-route) [
    [a b] ->

    let segment one-of edges with [
      end1 = a and end2 = b
    ]

    if segment != nobody [
      if [road-type] of segment != "turn" and
         not member? "bike" [allowed-modes] of segment [
        set walking-length
          walking-length + [road-length] of segment
      ]
    ]
  ])

  report walking-length * meters-per-netlogo-unit
end

to debug-bike-routes-core

  let bike-routes filter [
    r -> item 0 r = "bike"
  ] real-route-cache

  foreach bike-routes [
    r ->

    show (word
      "Bike " item 1 r
      " -> " item 2 r
      " | walking m: "
      precision
        (bike-path-walking-m
          (fput (item 3 r) (item 5 r)))
        2
    )
  ]

  show (word
    "Total actual bicycle walking distance m: "
    precision bike-walking-distance-total-m 2
  )
end

to-report low-speed-upper-limit [mode]
  if mode = "car"        [ report 15 ]
  if mode = "bike"       [ report 7 ]
  if mode = "pedestrian" [ report 2 ]

  report 15
end

to-report intermediate-speed-upper-limit [mode]
  if mode = "car"        [ report 25 ]
  if mode = "bike"       [ report 14 ]
  if mode = "pedestrian" [ report 4 ]

  report 25
end

to select.origin
  if mouse-down? [
    let p nearest-origin-point mouse-xcor mouse-ycor

    if p != nobody [
      set origin-point p

      ask p [
        set color green
        set size 0.18
      ]

      user-message "Origin selected."
    ]

    wait 0.2
  ]
end

to-report random-valid-origin [mode]
  let candidates (turtle-set nodes waypoints) with [
    any? my-out-edges with [
      member? mode allowed-modes
    ]
  ]

  if not any? candidates [
    report nobody
  ]

  report one-of candidates
end

to-report random-valid-destination [mode]
  let candidates (turtle-set nodes waypoints) with [
    any? my-in-edges with [
      member? mode allowed-modes
    ]
  ]

  if not any? candidates [
    report nobody
  ]

  report one-of candidates
end

to generate-random-agent-from-pool [mode]

  if count mobile-agents >= max-active-vehicles [
    stop
  ]

  let candidates filter [r -> item 0 r = mode] route-pool

  if empty? candidates [
    set failed-paths failed-paths + 1
    stop
  ]

  let selected-route one-of candidates

  set route-pool remove selected-route route-pool

  let origin item 1 selected-route
  let destination item 2 selected-route
  let new-path item 3 selected-route

  create-mobile-agent mode origin destination new-path

  set generated-vehicles generated-vehicles + 1
end

to precompute-all-random-routes
  set route-pool []

  precompute-random-routes "car" route-pool-target-size
  precompute-random-routes "bike" route-pool-target-size
  precompute-random-routes "pedestrian" route-pool-target-size
end

to debug-route-pool
  show (word "car routes in pool: " length filter [r -> item 0 r = "car"] route-pool)
  show (word "bike routes in pool: " length filter [r -> item 0 r = "bike"] route-pool)
  show (word "pedestrian routes in pool: " length filter [r -> item 0 r = "pedestrian"] route-pool)
end

to precompute-random-routes [mode number-of-routes]

  let attempts 0
  let max-attempts number-of-routes * 20
  let created 0

  while [created < number-of-routes and attempts < max-attempts] [

    set attempts attempts + 1

    let origin random-valid-origin mode
    let destination random-valid-destination mode

    if origin != nobody and destination != nobody and origin != destination [

      let new-path shortest-path origin destination mode

      if not empty? new-path [
        set route-pool lput (list mode origin destination new-path) route-pool
        set created created + 1
      ]
    ]
  ]

  show (word "Precomputed " mode " routes: " created)
end

to generate-traffic-if-needed
  if sim-time-seconds - last-vehicle-generation-time >= vehicle-generation-interval-seconds [

    let mode traffic-generation-mode

    if mode = "mixed" [
      set mode one-of ["car" "bike" "pedestrian"]
    ]

    generate-random-agent-from-pool mode
    set last-vehicle-generation-time sim-time-seconds
  ]
end

to-report nearest-origin-point [x y]
  let graph-points (turtle-set nodes waypoints) with [
    any? my-out-edges with [
      member? "car" allowed-modes
    ]
  ]

  if not any? graph-points [
    report nobody
  ]

  report min-one-of graph-points [distancexy x y]
end

to select.destination
  if mouse-down? [
    let p nearest-destination-point mouse-xcor mouse-ycor

    if p != nobody [
      set destination-point p

      ask p [
        set color magenta
        set size 0.18
      ]

      user-message "Destination selected."
    ]

    wait 0.2
  ]
end

to-report nearest-destination-point [x y]
  let graph-points (turtle-set nodes waypoints) with [
    any? my-in-edges with [
      member? "car" allowed-modes
    ]
  ]

  if not any? graph-points [
    report nobody
  ]

  report min-one-of graph-points [distancexy x y]
end

to-report shortest-path [source target mode]
  
  if mode = "bike" [
    let full-route preferred-bike-path
      (turtle-set source)
      (turtle-set target)

    if empty? full-route [
      report []
    ]

    report but-first full-route
  ]

  let graph-points (turtle-set nodes waypoints)

  ask graph-points [
    set dist 999999999
    set previous nobody
    set visited? false
  ]

  ask source [
    set dist 0
  ]
  let iterations 0
  let max-iterations 100000

  while [any? graph-points with [not visited?] and iterations < max-iterations] [

    set iterations iterations + 1

    let current min-one-of graph-points with [not visited?] [dist]

    if current = nobody [
      report []
    ]

    if [dist] of current = 999999999 [
      report []
    ]

    if current = target [
      report build-path source target
    ]

    ask current [
      set visited? true
    ]

    let outgoing-edges [my-out-edges with [
      member? mode allowed-modes
    ]] of current

    ask outgoing-edges [
      let neighbor end2
      let alt ([dist] of current) + road-length

      if alt < [dist] of neighbor [
        ask neighbor [
          set dist alt
          set previous current
        ]
      ]
    ]
  ]

  report []
end

to-report build-path [source target]

  let result []
  let current target

  while [current != nobody and current != source] [
    set result fput current result
    set current [previous] of current
  ]

  if current = source [
    report result
  ]

  report []
end

to create.vehicle.from.selection
  if origin-point = nobody or destination-point = nobody [
    user-message "Select an origin and a destination."
    stop
  ]

  set selected-path shortest-path origin-point destination-point "car"

  if empty? selected-path [
    user-message "It hasn't found a path between the origin and the destination."
    stop
  ]

  create-vehicles 1 [
    set color yellow
    set size 0.5
    set shape "car"
    set agent-mode "car"
    set roundabout-inside? false

    set current-node origin-point
    move-to current-node

    set destination-node destination-point
    set path selected-path

    set previous-node nobody
    set next-node nobody
    set speed-factor bounded-random-normal 1 0.15 0.6 1.4
    set speed kmh-to-netlogo-speed (vehicle-speed-kmh * speed-factor)
    set stopped? false
    set arrived? false
    set waiting-time 0
  ]

  highlight-selected-path

end

to highlight-selected-path
  if origin-point = nobody or empty? selected-path [
    stop
  ]

  let full-path fput origin-point selected-path
  let i 0

  while [i < length full-path - 1] [
    let a item i full-path
    let b item (i + 1) full-path

    let edg one-of edges with [end1 = a and end2 = b]

    if edg != nobody [
      ask edg [
        set color green
        set thickness 0.03
      ]
    ]

    set i i + 1
  ]
end

to-report nearest-graph-point [x y]
  let graph-points (turtle-set nodes waypoints)

  if not any? graph-points [
    report nobody
  ]

  report min-one-of graph-points [distancexy x y]
end

to-report kmh-to-mps [kmh]
  report kmh / 3.6
end

to-report kmh-to-netlogo-speed [kmh]
  if meters-per-netlogo-unit <= 0 [
    user-message "meters-per-netlogo-unit must be greater than 0. Execute setup."
    report 0
  ]

  report ((kmh-to-mps kmh) / meters-per-netlogo-unit) * seconds-per-tick
end

to update.mobile-agent.speed
  ask mobile-agents [
    set speed kmh-to-netlogo-speed (speed-kmh-from-mode agent-mode * speed-factor)
  ]
end

to-report two-digits [n]
  if n < 10 [
    report word "0" n
  ]

  report word n ""
end

to-report slot-start-time [slot-value]
  let total-minutes slot-value * 15
  let hour-value floor (total-minutes / 60)
  let minute-value total-minutes mod 60

  report (word
    two-digits hour-value
    ":"
    two-digits minute-value
  )
end

to-report selected-flow-end-time
  let end-minutes
    (selected-flow-slot * 15) +
    simulation-duration-minutes

  let normalized-minutes end-minutes mod 1440

  let hour-value floor (normalized-minutes / 60)
  let minute-value normalized-minutes mod 60

  report (word
    two-digits hour-value
    ":"
    two-digits minute-value
  )
end

to-report sim-clock
  let total floor sim-time-seconds
  let h floor (total / 3600)
  let m floor ((total mod 3600) / 60)
  let s total mod 60

  report (word two-digits h ":" two-digits m ":" two-digits s)
end

to export.world
  export-world "data/saved_graph_world.csv"
end

to export-results
  file-close-all
  file-open "outputs/simulation_results.csv"
  file-print "sim_time_seconds,number_of_vehicles,vehicle_speed_kmh,total_vehicles"
  file-print (word sim-time-seconds "," number-of-vehicles "," vehicle-speed-kmh "," count vehicles)
  file-close
end

to go-manual
  update-copresence-times
  update-encounters
  update.mobile-agent.speed
  move.mobile-agents
  update-speed-duration-times

  set sim-time-seconds sim-time-seconds + seconds-per-tick
  finish-arrived-trips
  tick
end

to go
  if sim-time-seconds >= simulation-duration-seconds [
    user-message "Simulation finished."
    stop
  ]

  generate-traffic-if-needed
  update-copresence-times
  update-encounters
  update.mobile-agent.speed
  move.mobile-agents
  update-speed-duration-times

  set sim-time-seconds sim-time-seconds + seconds-per-tick
  finish-arrived-trips
  tick
end

to initialize-simulation
  setup
  precompute-all-random-routes

  let mode traffic-generation-mode

  if mode = "mixed" [
    set mode one-of ["car" "bike" "pedestrian"]
  ]

  generate-random-agent-from-pool mode
  debug-route-pool
  set last-vehicle-generation-time sim-time-seconds
end

to demo-run
  setup
  create.vehicles

  repeat 100 [
    go
  ]

  export-results

  user-message "Demo finished. Results exported to outputs/simulation_results.csv"
end

to setup-real-flow-simulation
  setup
  set simulation-duration-seconds simulation-duration-minutes * 60
  reset-timer
  load-flow-zones
  show (word "load-flow-zones time: " timer)

  reset-timer
  assign-flow-zone-nodes
  show (word "assign-flow-zone-nodes time: " timer)

  reset-timer
  load-flow-counts
  show (word "load-flow-counts time: " timer)

  let requested-slots selected-flow-slots
  let maximum-slot maximum-available-flow-slot

  if empty? requested-slots [
    user-message "No flow slots were selected."
    stop
  ]

  if last requested-slots > maximum-slot [
    user-message
      (word
        "The selected duration requires slots "
        first requested-slots
        " to "
        last requested-slots
        ", but the last available slot is "
        maximum-slot
        "."
      )
    stop
  ]

  show (word
    "Simulation duration: "
    simulation-duration-minutes
    " minutes"
  )

  show (word
    "Selected flow slots: "
    requested-slots
  )

  reset-timer
  precompute-zone-to-zone-routes
  show (word "precompute-zone-to-zone-routes time: " timer)

  reset-timer
  precompute-real-flow-routes
  show (word "precompute-real-flow-routes time: " timer)
end

to-report real-flow-simulation-finished?
  report
    sim-time-seconds >= simulation-duration-seconds and
    empty? scheduled-trips and
    count mobile-agents = 0
end

to precompute-zone-to-zone-routes
  set real-route-cache []

  let transport-modes [
    "pedestrian"
    "bike"
    "car"
  ]

  let slots selected-flow-slots

  foreach transport-modes [
    transport-mode ->

    foreach sort flow-zones [
      origin-zone ->

      foreach sort flow-zones [
        target-zone ->

        if [zone-id] of origin-zone !=
           [zone-id] of target-zone [

          let route-needed? false

          foreach slots [
            slot-value ->

            let origin-flow
              get-flow-count
                slot-value
                ([zone-id] of origin-zone)
                transport-mode
                "inflow"

            let target-flow
              get-flow-count
                slot-value
                ([zone-id] of target-zone)
                transport-mode
                "outflow"

            if origin-flow > 0 and target-flow > 0 [
              set route-needed? true
            ]
          ]

          if route-needed? [
            show (word
              "Computing "
              transport-mode
              " from "
              [zone-id] of origin-zone
              " to "
              [zone-id] of target-zone
            )

            let route build-zone-route transport-mode origin-zone target-zone

            ifelse not empty? route [
              set real-route-cache lput route real-route-cache
            ]
            [
              show (word
                "No route found for "
                transport-mode
                " from "
                [zone-id] of origin-zone
                " to "
                [zone-id] of target-zone
              )
            ]
          ]
        ]
      ]
    ]
  ]

  show (word
    "Precomputed zone-to-zone routes: "
    length real-route-cache
  )
end

to-report radius-from-zone-id [zid]
  if zid = "7.1" [ report 2 ]
  if zid = "7.3" [ report 1.4 ]
  if zid = "7.4" [ report 2 ]
  if zid = "7.5" [ report 0.8 ]
  if zid = "7.6" [ report 2 ]

  report 0.6
end

to-report build-zone-route [transport-mode origin-zone target-zone]
  
  if transport-mode = "bike" [

    let starts get-candidate-nodes-from-zone
      origin-zone "bike" "inflow"

    let finishes get-candidate-nodes-from-zone
      target-zone "bike" "outflow"

    let full-route preferred-bike-path starts finishes

    if empty? full-route [
      report []
    ]

    let walked-m bike-path-walking-m full-route
    let route-kind "cycle-only"

    if walked-m > 0 [
      set route-kind "cycle-plus-walking"
    ]

    show (word
      "Bike route " [zone-id] of origin-zone
      " -> " [zone-id] of target-zone
      " | " route-kind
      " | walking m: " precision walked-m 2
    )

    report (list
      "bike"
      ([zone-id] of origin-zone)
      ([zone-id] of target-zone)
      (first full-route)
      (last full-route)
      (but-first full-route)
    )
  ]
  let origin-nodes get-candidate-nodes-from-zone origin-zone transport-mode "inflow"
  let target-nodes get-candidate-nodes-from-zone target-zone transport-mode "outflow"

  if (not any? origin-nodes) or (not any? target-nodes) [
    report []
  ]

  let origin-list sort origin-nodes
  let target-list sort target-nodes

  set origin-list sort-by [
    [a b] -> [distance origin-zone] of a < [distance origin-zone] of b
  ] origin-list

  set target-list sort-by [
    [a b] -> [distance target-zone] of a < [distance target-zone] of b
  ] target-list

  set origin-list first-n-items 5 origin-list
  set target-list first-n-items 5 target-list

  foreach origin-list [
    origin ->

    foreach target-list [
      destination ->

      if origin != destination [
        let new-path shortest-path origin destination transport-mode

        if not empty? new-path [
          report (list
            transport-mode
            ([zone-id] of origin-zone)
            ([zone-id] of target-zone)
            origin
            destination
            new-path
          )
        ]
      ]
    ]
  ]

  report []
end

to-report first-n-items [n lst]
  if length lst <= n [
    report lst
  ]

  report sublist lst 0 n
end

to debug-flow-zone-candidates
  ask flow-zones [
    show (word
      "Zone " zone-id
      " | ped in/out: " count pedestrian-in-nodes "/" count pedestrian-out-nodes
      " | bike in/out: " count bike-in-nodes "/" count bike-out-nodes
      " | car in/out: " count car-in-nodes "/" count car-out-nodes
    )
  ]
end

to load-flow-zones
  set flow-zones-dataset gis:load-dataset "data/10731/In_Out_15min.geojson"

  let created-zone-ids []

  foreach gis:feature-list-of flow-zones-dataset [
    feat ->

    let name-value word gis:property-value feat "name" ""
    let zid zone-id-from-name name-value

    if not member? zid created-zone-ids [

      let coords gis:location-of (first (first (gis:vertex-lists-of feat)))

      if not empty? coords [
        create-flow-zones 1 [
          setxy item 0 coords item 1 coords

          set zone-id zid
          set zone-radius radius-from-zone-id zid

          set pedestrian-in-nodes no-turtles
          set pedestrian-out-nodes no-turtles
          set bike-in-nodes no-turtles
          set bike-out-nodes no-turtles
          set car-in-nodes no-turtles
          set car-out-nodes no-turtles

          set shape "circle"
          set size zone-radius
          set color green
        ]

        set created-zone-ids lput zid created-zone-ids
      ]
    ]
  ]

  show (word "Loaded flow zones: " count flow-zones)
end

to assign-flow-zone-nodes
  ask flow-zones [
    set pedestrian-in-nodes candidate-nodes-for-zone self "pedestrian" "inflow"
    set pedestrian-out-nodes candidate-nodes-for-zone self "pedestrian" "outflow"

    set bike-in-nodes candidate-nodes-for-zone self "bike" "inflow"
    set bike-out-nodes candidate-nodes-for-zone self "bike" "outflow"

    set car-in-nodes candidate-nodes-for-zone self "car" "inflow"
    set car-out-nodes candidate-nodes-for-zone self "car" "outflow"
  ]
end

to-report candidate-nodes-for-zone [z mode direction]
  let graph-points no-turtles

  if direction = "inflow" [
    set graph-points (turtle-set nodes waypoints) with [
      any? my-out-edges with [
        member? mode allowed-modes
      ]
    ]
  ]

  if direction = "outflow" [
    set graph-points (turtle-set nodes waypoints) with [
      any? my-in-edges with [
        member? mode allowed-modes
      ]
    ]
  ]

  if not any? graph-points [
    report no-turtles
  ]

  let nearby graph-points with [
    distance z <= [zone-radius] of z
  ]

  if any? nearby [
    report nearby
  ]

  report min-n-of 15 graph-points [
    distance z
  ]
end

to-report zone-id-from-name [txt]
  let result ""
  let i 0

  while [i < length txt] [
    let ch substring txt i (i + 1)

    ifelse ch = "_" [
      set result ""
    ]
    [
      set result word result ch
    ]

    set i i + 1
  ]

  report result
end

to load-flow-counts
  let rows csv:from-file "dataNetlogo/flow_counts.csv"

  set flow-counts []

  foreach but-first rows [row ->
    let slot-value as-number item 0 row
    let zid word item 2 row ""
    let mode word item 3 row ""
    let direction word item 4 row ""
    let original-amount as-number item 5 row

    let scaled-amount original-amount * run-demand-factor

    set flow-counts lput
      (list slot-value zid mode direction scaled-amount)
      flow-counts
  ]

  show (word
    "Loaded flow count rows: " length flow-counts
    " | demand factor: " run-demand-factor
  )
end

to-report as-number [x]
  if is-number? x [
    report x
  ]

  report read-from-string (word x "")
end

to-report get-flow-count [slot-value zid mode direction]
  let matches filter [
    row ->
      item 0 row = slot-value and
      item 1 row = zid and
      item 2 row = mode and
      item 3 row = direction
  ] flow-counts

  if empty? matches [
    report 0
  ]

  report item 4 first matches
end

to-report get-candidate-nodes-from-zone [z mode direction]
  if mode = "pedestrian" [
    if direction = "inflow" [ report [pedestrian-in-nodes] of z ]
    if direction = "outflow" [ report [pedestrian-out-nodes] of z ]
  ]

  if mode = "bike" [
    if direction = "inflow" [ report [bike-in-nodes] of z ]
    if direction = "outflow" [ report [bike-out-nodes] of z ]
  ]

  if mode = "car" [
    if direction = "inflow" [ report [car-in-nodes] of z ]
    if direction = "outflow" [ report [car-out-nodes] of z ]
  ]

  report no-turtles
end

to-report get-outflow-used [slot-value zid mode]
  let matches filter [
    row ->
      item 0 row = slot-value and
      item 1 row = zid and
      item 2 row = mode
  ] outflow-usage

  if empty? matches [
    report 0
  ]

  report item 3 first matches
end

to increment-outflow-used [slot-value zid mode]
  let updated []
  let found? false

  foreach outflow-usage [
    row ->

    ifelse item 0 row = slot-value and item 1 row = zid and item 2 row = mode [
      set updated lput (list slot-value zid mode ((item 3 row) + 1)) updated
      set found? true
    ]
    [
      set updated lput row updated
    ]
  ]

  if not found? [
    set updated lput (list slot-value zid mode 1) updated
  ]

  set outflow-usage updated
end

to-report remaining-outflow-weight [slot-value zid mode]
  let expected get-flow-count slot-value zid mode "outflow"
  let used get-outflow-used slot-value zid mode

  let remaining expected - used

  if remaining > 0 [
    report remaining
  ]

  report 0
end

to-report choose-weighted-outflow-zone [slot-value mode origin-zone]
  let options sort flow-zones with [
    zone-id != [zone-id] of origin-zone and
    get-flow-count slot-value zone-id mode "outflow" > 0 and
    any? (get-candidate-nodes-from-zone self mode "outflow")
  ]

  if empty? options [
    report nobody
  ]

  let weights map [
    z -> remaining-outflow-weight slot-value ([zone-id] of z) mode
  ] options

  let total sum weights

  if total <= 0 [
    set weights map [
      z -> get-flow-count slot-value ([zone-id] of z) mode "outflow"
    ] options

    set total sum weights
  ]

  if total <= 0 [
    report item random length options options
  ]

  let r random-float total
  let acc 0
  let i 0

  while [i < length options] [
    set acc acc + item i weights

    if r <= acc [
      report item i options
    ]

    set i i + 1
  ]

  report last options
end

to-report number-of-selected-flow-slots
  report floor (
    simulation-duration-seconds /
    flow-slot-duration-seconds
  )
end

to-report selected-flow-slots
  let number-of-slots number-of-selected-flow-slots

  report n-values number-of-slots [
    slot-offset ->
      selected-flow-slot + slot-offset
  ]
end

to-report maximum-available-flow-slot
  if empty? flow-counts [
    report -1
  ]

  report max map [
    row -> item 0 row
  ] flow-counts
end

to precompute-real-flow-routes
  set scheduled-trips []
  set outflow-usage []
  let slots selected-flow-slots

  let inflow-rows filter [
    row ->
      member? (item 0 row) slots and
      item 3 row = "inflow" and
      item 4 row > 0
  ] flow-counts

  foreach inflow-rows [
    row ->

    let slot-value item 0 row
    let zid item 1 row
    let mode item 2 row
    let amount round item 4 row

    let origin-zone one-of flow-zones with [
      zone-id = zid
    ]

    if origin-zone != nobody [
      repeat amount [
        let trip build-real-flow-trip slot-value mode origin-zone

        ifelse not empty? trip [
          set scheduled-trips
            lput trip scheduled-trips
        ]
        [
          set failed-paths failed-paths + 1
        ]
      ]
    ]
  ]

  set scheduled-trips sort-by [
    [trip-a trip-b] ->
      item 0 trip-a < item 0 trip-b
  ] scheduled-trips

  show (word "Selected slots: " slots)
  show (word "Precomputed real trips: " length scheduled-trips)
  show (word "Failed real trips: " failed-paths)
end

to-report build-real-flow-trip
  [slot-value mode origin-zone]

  let cached-route choose-weighted-cached-route slot-value mode origin-zone

  if empty? cached-route [
    report []
  ]

  let target-zid item 2 cached-route
  let origin item 3 cached-route
  let destination item 4 cached-route
  let new-path item 5 cached-route

  increment-outflow-used
    slot-value
    target-zid
    mode

  let slot-offset slot-value - selected-flow-slot

  let slot-starting-time slot-offset * flow-slot-duration-seconds

  let spawn-time slot-starting-time + random-float flow-slot-duration-seconds

  report (list
    spawn-time
    mode
    ([zone-id] of origin-zone)
    target-zid
    origin
    destination
    new-path
    slot-value
  )
end

to-report completed-trip-count-by-mode [transport-mode]

  if transport-mode = "all" [
    report length completed-trip-metrics
  ]

  report length filter [
    record ->
      item 0 record = transport-mode
  ] completed-trip-metrics
end

to-report choose-weighted-cached-route [slot-value mode origin-zone]
  let candidates filter [
    r ->
      item 0 r = mode and
      item 1 r = [zone-id] of origin-zone
  ] real-route-cache

  if empty? candidates [
    report []
  ]

  let weights map [
    r -> remaining-outflow-weight slot-value (item 2 r) mode
  ] candidates

  let total sum weights

  if total <= 0 [
    set weights map [
      r -> get-flow-count slot-value (item 2 r) mode "outflow"
    ] candidates

    set total sum weights
  ]

  if total <= 0 [
    report item random length candidates candidates
  ]

  let r random-float total
  let acc 0
  let i 0

  while [i < length candidates] [
    set acc acc + item i weights

    if r <= acc [
      report item i candidates
    ]

    set i i + 1
  ]

  report last candidates
end

to create-scheduled-mobile-agent [mode origin destination new-path origin-zid target-zid spawn-time source-slot]
  if mode = "car" [
    create-vehicles 1 [
      set color yellow
      set size 0.5
      set shape "car"

      setup-mobile-agent mode origin destination new-path

      set origin-zone-id origin-zid
      set destination-zone-id target-zid
      set scheduled-spawn-time spawn-time
      set flow-slot-id source-slot
    ]
    stop
  ]

  if mode = "bike" [
    create-bicycles 1 [
      set color pink
      set size 0.5
      set shape "wheel"

      setup-mobile-agent mode origin destination new-path

      set origin-zone-id origin-zid
      set destination-zone-id target-zid
      set scheduled-spawn-time spawn-time
      set flow-slot-id source-slot
    ]
    stop
  ]

  if mode = "pedestrian" [
    create-pedestrians 1 [
      set color orange
      set size 0.3
      set shape "person"

      setup-mobile-agent mode origin destination new-path

      set origin-zone-id origin-zid
      set destination-zone-id target-zid
      set scheduled-spawn-time spawn-time
      set flow-slot-id source-slot
    ]
    stop
  ]
end

to generate-scheduled-real-agents
  while [
    not empty? scheduled-trips and
    item 0 first scheduled-trips <= sim-time-seconds and
    count mobile-agents < max-active-vehicles
  ] [

    let trip first scheduled-trips
    set scheduled-trips but-first scheduled-trips

    let spawn-time item 0 trip
    let mode item 1 trip
    let origin-zid item 2 trip
    let target-zid item 3 trip
    let origin item 4 trip
    let destination item 5 trip
    let new-path item 6 trip
    let source-slot item 7 trip

    create-scheduled-mobile-agent mode origin destination new-path origin-zid target-zid spawn-time source-slot

    set generated-vehicles generated-vehicles + 1
  ]
end

to-report average-trajectory-distance-km [transport-mode]
  let records completed-trip-records-by-mode transport-mode

  if empty? records [
    report 0
  ]

  report mean map [
    r -> item 3 r
  ] records
end

to-report average-trajectory-speed-kmh [transport-mode]
  let records completed-trip-records-by-mode transport-mode

  if empty? records [
    report 0
  ]

  report mean map [
    r -> item 2 r
  ] records
end

to-report average-trajectory-duration-min [transport-mode]
  let records completed-trip-records-by-mode transport-mode

  if empty? records [
    report 0
  ]

  report mean map [
    r -> item 1 r
  ] records
end

to-report completed-trip-records-by-mode [transport-mode]
  if transport-mode = "all" [
    report completed-trip-metrics
  ]

  report filter [
    r -> item 0 r = transport-mode
  ] completed-trip-metrics
end

to update-trajectory-duration-plot
  set-current-plot "Trajectory duration"
  
  let time-min sim-time-seconds / 60

  set-current-plot-pen "all"
  plotxy time-min average-trajectory-duration-min "all"

  set-current-plot-pen "car"
  plotxy time-min average-trajectory-duration-min "car"

  set-current-plot-pen "bike"
  plotxy time-min average-trajectory-duration-min "bike"

  set-current-plot-pen "pedestrian"
  plotxy time-min average-trajectory-duration-min "pedestrian"
end

to update-trajectory-speed-plot
  set-current-plot "Trajectory speed"
  
  let time-min sim-time-seconds / 60

  set-current-plot-pen "all"
  plotxy time-min average-trajectory-speed-kmh "all"

  set-current-plot-pen "car"
  plotxy time-min average-trajectory-speed-kmh "car"

  set-current-plot-pen "bike"
  plotxy time-min average-trajectory-speed-kmh "bike"

  set-current-plot-pen "pedestrian"
  plotxy time-min average-trajectory-speed-kmh "pedestrian"
end

