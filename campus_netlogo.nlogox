<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[extensions [ gis ]

globals 
[ 
  buildings
  roads
  zones
  busway
  footway
  motorway
  pedestrianway
  bicycleway

  nodes-dataset
  edges-dataset
  
  origin-point
  destination-point
  selected-path
  
  sim-time-seconds
  seconds-per-tick
  meters-per-netlogo-unit
  
  vehicle-safety-distance
  intersection-safety-distance
  movement-step-size
  
  simulation-duration-seconds
  last-vehicle-generation-time
  generated-vehicles
  completed-trips
  failed-paths
  
  right-priority-radius
  roundabout-priority-radius
  deadlock-release-time
  
  route-pool
  route-pool-target-size
]

breed [ vehicles vehicle ]
breed [ pedestrians pedestrian ]
breed [ bicycles bicycle ]
breed [ buses bus ]

breed [ nodes node ]
breed [ waypoints waypoint ]
directed-link-breed [ edges edge ]

nodes-own [
  node-id
  lane-direction
  node-key
  dist
  previous
  visited?
  intersection?
  roundabout-node?
]

waypoints-own [
  lane-direction
  road-id
  dist
  previous
  visited?
]

edges-own [
  road-type
  road-length
  edge-road-id
  allowed-modes
  roundabout?
]

turtles-own [
  current-node
  next-node
  previous-node
  destination-node
  path
  speed
  speed-factor
  arrived?
  stopped?
  agent-mode
  waiting-time
]

vehicles-own [
]

buses-own [
]

bicycles-own [
]

to setup
  clear-all
  
  set origin-point nobody
  set destination-point nobody
  set selected-path []

  set sim-time-seconds 0
  set seconds-per-tick 0.2
  set meters-per-netlogo-unit 5
  
  set vehicle-safety-distance 0.12
  set intersection-safety-distance 0.10
  set movement-step-size 0.03
  
  set simulation-duration-seconds simulation-duration-minutes * 60
  set last-vehicle-generation-time (- vehicle-generation-interval-seconds)
  set generated-vehicles 0
  set completed-trips 0
  set failed-paths 0
  
  set right-priority-radius 0.30
  set roundabout-priority-radius 0.35
  set deadlock-release-time 4
  
  set route-pool []
  set route-pool-target-size 25
  
  load-gis
  draw-gis
  load-graph-from-shp
  reset-ticks
end

to load-gis
  set buildings gis:load-dataset "data/Gross_data/Buildings_gross.shp"
  set roads gis:load-dataset "data/Gross_data/Roads_gross.shp"
  set zones gis:load-dataset "data/Gross_data/zone.shp"

  set nodes-dataset gis:load-dataset "dataNetlogo/Netlogo_nodes.shp"
  set edges-dataset gis:load-dataset "dataNetlogo/ultimo_roads.shp"

  gis:set-world-envelope
  (gis:envelope-union-of
    (gis:envelope-of zones)
    (gis:envelope-of nodes-dataset)
    (gis:envelope-of edges-dataset))
end

to draw-gis
  ask patches [
    set pcolor white
  ]

  gis:set-drawing-color green
  gis:draw zones 5

  gis:set-drawing-color gray
  gis:fill buildings 1

  gis:set-drawing-color black
  gis:draw buildings 1

end

to load-graph-from-shp
  load-nodes
  load-full-edges-by-geometry
  create-turn-connectors
  identify-traffic-nodes
end

to-report mobile-agents
  report (turtle-set vehicles buses bicycles pedestrians)
end

to setup-mobile-agent [mode origin destination new-path]
  set agent-mode mode
  set current-node origin
  move-to current-node
  set destination-node destination
  set path new-path
  set previous-node nobody
  set next-node nobody
  set speed-factor bounded-random-normal 1 0.15 0.6 1.4
  set speed kmh-to-netlogo-speed (speed-kmh-from-mode mode * speed-factor)
  set stopped? false
  set arrived? false
  set waiting-time 0
end

to-report speed-kmh-from-mode [mode]
  if mode = "car" [ report vehicle-speed-kmh ]
  if mode = "bus" [ report 20 ]
  if mode = "bike" [ report 15 ]
  if mode = "pedestrian" [ report 5 ]
  report vehicle-speed-kmh
end

to create-mobile-agent [mode origin destination new-path]
  if mode = "car" [
    create-vehicles 1 [
      set color yellow
      set size 0.5
      set shape "car"
      setup-mobile-agent mode origin destination new-path
    ]
    stop
  ]

  if mode = "bus" [
    create-buses 1 [
      set color blue
      set size 0.8
      set shape "bus"
      setup-mobile-agent mode origin destination new-path
    ]
    stop
  ]

  if mode = "bike" [
    create-bicycles 1 [
      set color pink
      set size 0.5
      set shape "wheel"
      setup-mobile-agent mode origin destination new-path
    ]
    stop
  ]

  if mode = "pedestrian" [
    create-pedestrians 1 [
      set color orange
      set size 0.3
      set shape "person"
      setup-mobile-agent mode origin destination new-path
    ]
    stop
  ]
end

to identify-traffic-nodes
  ask nodes [
    let real-in count my-in-edges with [road-type != "turn"]
    let real-out count my-out-edges with [road-type != "turn"]

    set intersection? (real-in + real-out >= 3)

    set roundabout-node?
      ((any? my-in-edges with [roundabout?]) or
       (any? my-out-edges with [roundabout?]))

    if intersection? [
      set size 0.11
    ]

    if roundabout-node? [
      set size 0.13
    ]
  ]
end

to load-nodes
  let id-counter 0

  foreach gis:feature-list-of nodes-dataset [
    feat ->

    let coords gis:location-of (first (first (gis:vertex-lists-of feat)))

    if not empty? coords [
      let k coord-key coords

      create-nodes 1 [
        set node-id id-counter
        set node-key k
        set lane-direction "forward"
        setxy item 0 coords item 1 coords
        set color cyan
        set size 0.08
        set shape "circle"
      ]

      create-nodes 1 [
        set node-id id-counter
        set node-key k
        set lane-direction "backward"
        setxy item 0 coords item 1 coords
        set color blue
        set size 0.08
        set shape "circle"
      ]

      set id-counter id-counter + 1
    ]
  ]
end

to load-full-edges-by-geometry
  foreach gis:feature-list-of edges-dataset [
    feat ->
    
    let mode allowed-modes-from-feature feat
    let direction-value word gis:property-value feat "ONEWAY_" ""
    let round-value word gis:property-value feat "ISROUND_" ""
    let current-road-id gis:property-value feat "ID_"

    foreach gis:vertex-lists-of feat [
      vlist ->

      let loc-list []

      foreach vlist [
        v ->
        let loc gis:location-of v

        if not empty? loc [
          set loc-list lput loc loc-list
        ]
      ]

      if length loc-list >= 2 [

        ifelse round-value = "true" [
          create-road-path loc-list current-road-id "forward" "roundabout" mode
        ]
        [
          if direction-value = "yes" [
            create-road-path loc-list current-road-id "forward" "oneway" mode
          ]

          if direction-value = "" or direction-value = "no" [
            create-road-path loc-list current-road-id "forward" "two-way-forward" mode
            create-road-path reverse loc-list current-road-id "backward" "two-way-backward" mode
          ]
        ]
      ]
    ]
  ]
end

to create-road-path [loc-list current-road-id lane-dir link-type mode]

  let previous-agent nobody
  let i 0

  foreach loc-list [
    loc ->

    let current-agent nobody

    ifelse i = 0 or i = (length loc-list - 1)
    [
      set current-agent node-at-location loc lane-dir
    ]
    [
      create-waypoints 1 [
        setxy item 0 loc item 1 loc
        set lane-direction lane-dir
        set road-id current-road-id
        set color gray
        set size 0.06
        set shape "circle"
        set current-agent self
      ]
    ]

    if previous-agent != nobody and current-agent != nobody [
      connect-graph-agents previous-agent current-agent link-type current-road-id mode
    ]

    set previous-agent current-agent
    set i i + 1
  ]
end

to connect-graph-agents [a b link-type current-road-id mode]

  let d [distance b] of a

  ask a [
    if not out-link-neighbor? b [
      create-edge-to b [
        set color edge-color-from-modes mode
        set thickness 0.012
        set road-type link-type
        set edge-road-id current-road-id
        set road-length d
        set allowed-modes mode
        set roundabout? link-type = "roundabout"
      ]
    ]
  ]
end

to-report flatten-modes [mode-lists]
  let result []

  foreach mode-lists [
    lst ->
    set result sentence result lst
  ]

  report remove-duplicates result
end

to-report common-modes [list-a list-b]
  let result []

  foreach list-a [
    m ->
    if member? m list-b [
      set result lput m result
    ]
  ]

  report remove-duplicates result
end

to-report allowed-modes-from-feature [feat]

  let type-value word gis:property-value feat "TYPE_" ""
  let category-value word gis:property-value feat "CATEGORY_" ""
  let is-bus-value word gis:property-value feat "ISOPBUS_" ""
  let bus-routes word gis:property-value feat "BUSRTS_" ""

  let mode []

  if type-value = "busway" or is-bus-value = "true" or bus-routes != "[]" [
    set mode lput "bus" mode
  ]

  if category-value = "road" and type-value != "busway" [
    set mode lput "car" mode
  ]

  if category-value = "cycleway" [
    set mode lput "bike" mode
  ]

  if category-value = "pedestrian" or
     type-value = "footway" or
     type-value = "path" or
     type-value = "steps" or
     type-value = "platform" [
    set mode lput "pedestrian" mode
  ]

  if empty? mode [
    set mode ["car"]
  ]
  report remove-duplicates mode
end

to-report edge-color-from-modes [mode]

  if member? "bus" mode and not member? "car" mode and not member? "bike" mode and not member? "pedestrian" mode [
    report blue
  ]

  if member? "bike" mode and not member? "car" mode and not member? "bus" mode and not member? "pedestrian" mode [
    report pink
  ]

  if member? "pedestrian" mode and not member? "car" mode and not member? "bus" mode and not member? "bike" mode [
    report orange
  ]

  if member? "car" mode and not member? "bus" mode and not member? "bike" mode and not member? "pedestrian" mode [
    report red
  ]

  if length mode > 1 [
    report violet
  ]

  report black
end

to create-turn-connectors

  ask edges with [road-type = "turn"] [
    die
  ]

  let keys remove-duplicates [node-key] of nodes

  foreach keys [
    k ->

    let intersection-nodes nodes with [
      node-key = k
    ]

    let arrival-nodes intersection-nodes with [
      any? my-in-edges with [road-type != "turn"]
    ]

    let departure-nodes intersection-nodes with [
      any? my-out-edges with [road-type != "turn"]
    ]

    ask arrival-nodes [
      let arrival self

      let arrival-modes flatten-modes [allowed-modes] of my-in-edges with [
        road-type != "turn"
      ]

      ask departure-nodes with [self != arrival] [
        let departure self

        let departure-modes flatten-modes [allowed-modes] of my-out-edges with [
          road-type != "turn"
        ]

        let turn-modes common-modes arrival-modes departure-modes

        if not empty? turn-modes [
          ask arrival [
            if not out-link-neighbor? departure [
              create-edge-to departure [
                set color edge-color-from-modes turn-modes
                set thickness 0.008
                set road-type "turn"
                set edge-road-id "turn"
                set road-length 0.01
                set allowed-modes turn-modes
                set roundabout? false
              ]
            ]
          ]
        ]
      ]
    ]
  ]
end

to-report coord-key [loc]
  let x item 0 loc
  let y item 1 loc
  report (word precision x 6 "," precision y 6)
end

to-report node-at-location [loc lane-dir]
  let k coord-key loc
  let candidates nodes with [
    node-key = k and lane-direction = lane-dir
  ]

  if any? candidates [
    report one-of candidates
  ]

  let x item 0 loc
  let y item 1 loc

  let fallback min-one-of nodes with [lane-direction = lane-dir] [
    distancexy x y
  ]

  report fallback
end

to create.vehicles
  let valid-start-points (turtle-set nodes waypoints) with [
    any? my-out-edges with [
      member? "car" allowed-modes
    ]
  ]

  if not any? valid-start-points [
    user-message "No hay puntos con links salientes. Revisa la creación de edges."
    stop
  ]

  create-vehicles number-of-vehicles [
    set color yellow
    set size 0.5
    set shape "car"
    set agent-mode "car"

    set current-node one-of valid-start-points
    move-to current-node

    set previous-node nobody
    set next-node nobody
    set destination-node nobody
    set path []
    
    set speed-factor bounded-random-normal 1 0.15 0.6 1.4
    set speed kmh-to-netlogo-speed (vehicle-speed-kmh * speed-factor)
    set arrived? false
    set stopped? false
    set waiting-time 0
  ]
end

to-report vehicle-ahead-on-same-segment? [target]

  let my-current current-node
  let my-target target
  let my-distance-to-target distance target

  report any? other mobile-agents with [
    current-node = my-current and
    next-node = my-target and
    distance my-target < my-distance-to-target and
    distance myself < vehicle-safety-distance
  ]
end

to-report target-node-busy? [target]
  report false
end

to-report vehicle-ahead-on-same-segment [target]

  let my-current current-node
  let my-target target
  let my-distance-to-target distance target

  let candidates other mobile-agents with [
    not arrived? and
    current-node = my-current and
    next-node = my-target and
    distance my-target < my-distance-to-target
  ]

  if not any? candidates [
    report nobody
  ]

  report min-one-of candidates [distance myself]
end

to-report adjusted-step-distance [desired-step target]

  let front-car vehicle-ahead-on-same-segment target

  if front-car = nobody [
    report desired-step
  ]

  let gap distance front-car

  if gap < vehicle-safety-distance [
    report 0
  ]

  let front-speed [speed] of front-car

  report min (list desired-step front-speed)
end

to vehicle-arrive
  if destination-node != nobody [
    move-to destination-node
    set current-node destination-node
  ]

  set completed-trips completed-trips + 1
  die
end

to-report position-blocked? [move-distance]

  let front-car vehicle-ahead-on-same-segment next-node

  if front-car = nobody [
    report false
  ]

  report distance front-car < vehicle-safety-distance
end

to-report on-roundabout?
  if current-node = nobody or next-node = nobody [
    report false
  ]

  let c current-node
  let n next-node

  report any? edges with [
    roundabout? and end1 = c and end2 = n
  ]
end

to-report next-edge-roundabout? [target]
  let my-current current-node

  if my-current = nobody or target = nobody [
    report false
  ]

  report any? edges with [
    roundabout? and
    end1 = my-current and
    end2 = target
  ]
end

to-report roundabout-entry-blocked? [target]

  if waiting-time >= deadlock-release-time [
    report false
  ]

  if not next-edge-roundabout? target [
    report false
  ]

  if on-roundabout? [
    report false
  ]

  report any? other mobile-agents with [
    not arrived? and
    on-roundabout? and
    (
      next-node = target or
      distance target < roundabout-priority-radius
    )
  ]
end

to-report has-priority-over-me? [other-car target]

  let my-wait waiting-time
  let my-distance distance target

  let other-wait [waiting-time] of other-car
  let other-distance [distance target] of other-car

  if other-wait > my-wait + 0.5 [
    report true
  ]

  if abs (other-wait - my-wait) <= 0.5 and other-distance < my-distance [
    report true
  ]

  report false
end

to-report vehicle-from-right-near? [target]

  let my-x xcor
  let my-y ycor
  let my-heading heading
  let right-heading (my-heading + 90) mod 360

  let blockers other mobile-agents with [
    not arrived? and
    next-node = target and
    distance target < right-priority-radius and
    (abs (subtract-headings
      (atan (xcor - my-x) (ycor - my-y))
      right-heading)) < 70
  ]

  if not any? blockers [
    report false
  ]

  let blocked? false

  foreach sort blockers [
    other-car ->
    if has-priority-over-me? other-car target [
      set blocked? true
    ]
  ]

  report blocked?
end

to-report traffic-priority-blocked? [target]
  
  if agent-mode = "pedestrian" [
    report false
  ]

  if target = nobody [
    report false
  ]

  if waiting-time >= deadlock-release-time [
    report false
  ]

  if roundabout-entry-blocked? target [
    report true
  ]

  if [breed] of target = nodes [
    if [intersection?] of target and not [roundabout-node?] of target [
      if vehicle-from-right-near? target [
        report true
      ]
    ]
  ]

  report false
end

to-report bounded-random-normal [mean-value sd-value min-value max-value]
  let value random-normal mean-value sd-value

  if value < min-value [
    set value min-value
  ]

  if value > max-value [
    set value max-value
  ]

  report value
end

to move.mobile-agents
   ask mobile-agents [

    ifelse arrived? [
      set color green
      set next-node nobody
      set path []
      set speed 0
    ]
    [

      set stopped? false

      if destination-node != nobody and current-node = destination-node [
        vehicle-arrive
      ]

      if not arrived? [

        let remaining-distance speed
        let substeps 0
        let max-substeps 500

        while [remaining-distance > 0 and substeps < max-substeps and not arrived? and not stopped?] [

          set substeps substeps + 1

          if next-node = nobody [
            ifelse is-list? path and not empty? path [
              set next-node first path
              set path but-first path
            ]
            [
              if destination-node = nobody [
                
                let my-mode agent-mode

                let possible-links [my-out-edges with [
                  member? my-mode allowed-modes
                ]] of current-node
                
                if any? possible-links [
                  let chosen-link one-of possible-links
                  set next-node [end2] of chosen-link
                ]
              ]
            ]
          ]
          if next-node = nobody [
            set remaining-distance 0
          ]

          if next-node != nobody [

            let d distance next-node

            ifelse d < 0.0001 [

              ifelse target-node-busy? next-node [
                set stopped? true
                set color red
                set waiting-time waiting-time + seconds-per-tick
                set remaining-distance 0
              ]
              [
                set previous-node current-node
                set current-node next-node
                set next-node nobody
                set waiting-time 0

                if destination-node != nobody and current-node = destination-node [
                  vehicle-arrive
                  set remaining-distance 0
                ]
              ]

            ]
            [
              face next-node

              let desired-step-distance min (list remaining-distance d movement-step-size)
              let step-distance adjusted-step-distance desired-step-distance next-node
              
              ifelse step-distance = 0 [
                set stopped? true
                set color red
                set waiting-time waiting-time + seconds-per-tick
                set remaining-distance 0
              ]
              [
                ifelse traffic-priority-blocked? next-node [
                  set stopped? true
                  set color red
                  set waiting-time waiting-time + seconds-per-tick
                  set remaining-distance 0
                ]
                [
                  ifelse position-blocked? step-distance [
                    set stopped? true
                    set color red
                    set waiting-time waiting-time + seconds-per-tick
                    set remaining-distance 0
                  ]
                  [
                    fd step-distance
                    set waiting-time 0
                    set remaining-distance remaining-distance - step-distance
                    
                    if distance next-node < 0.0005 [
                      set previous-node current-node
                      set current-node next-node
                      set next-node nobody
                      
                      ifelse destination-node != nobody and current-node = destination-node [
                        vehicle-arrive
                        set remaining-distance 0
                      ]
                      [
                        if color != green [
                          ifelse [breed] of current-node = waypoints [
                            set color violet
                          ]
                          [
                            set color yellow
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    ]
  ]
end

to select.origin
  if mouse-down? [
    let p nearest-origin-point mouse-xcor mouse-ycor

    if p != nobody [
      set origin-point p

      ask p [
        set color green
        set size 0.18
      ]

      user-message "Origin selected."
    ]

    wait 0.2
  ]
end

to-report random-valid-origin [mode]
  let candidates (turtle-set nodes waypoints) with [
    any? my-out-edges with [
      member? mode allowed-modes
    ]
  ]

  if not any? candidates [
    report nobody
  ]

  report one-of candidates
end

to-report random-valid-destination [mode]
  let candidates (turtle-set nodes waypoints) with [
    any? my-in-edges with [
      member? mode allowed-modes
    ]
  ]

  if not any? candidates [
    report nobody
  ]

  report one-of candidates
end

to generate-random-agent-from-pool [mode]

  if count mobile-agents >= max-active-vehicles [
    stop
  ]

  let candidates filter [r -> item 0 r = mode] route-pool

  if empty? candidates [
    set failed-paths failed-paths + 1
    stop
  ]

  let selected-route one-of candidates

  set route-pool remove selected-route route-pool

  let origin item 1 selected-route
  let destination item 2 selected-route
  let new-path item 3 selected-route

  create-mobile-agent mode origin destination new-path

  set generated-vehicles generated-vehicles + 1
end

to precompute-all-random-routes
  set route-pool []

  precompute-random-routes "car" route-pool-target-size
  precompute-random-routes "bus" route-pool-target-size
  precompute-random-routes "bike" route-pool-target-size
  precompute-random-routes "pedestrian" route-pool-target-size
end

to debug-route-pool
  show (word "car routes in pool: " length filter [r -> item 0 r = "car"] route-pool)
  show (word "bus routes in pool: " length filter [r -> item 0 r = "bus"] route-pool)
  show (word "bike routes in pool: " length filter [r -> item 0 r = "bike"] route-pool)
  show (word "pedestrian routes in pool: " length filter [r -> item 0 r = "pedestrian"] route-pool)
end

to precompute-random-routes [mode number-of-routes]

  let attempts 0
  let max-attempts number-of-routes * 20
  let created 0

  while [created < number-of-routes and attempts < max-attempts] [

    set attempts attempts + 1

    let origin random-valid-origin mode
    let destination random-valid-destination mode

    if origin != nobody and destination != nobody and origin != destination [

      let new-path shortest-path origin destination mode

      if not empty? new-path [
        set route-pool lput (list mode origin destination new-path) route-pool
        set created created + 1
      ]
    ]
  ]

  show (word "Precomputed " mode " routes: " created)
end

to generate-traffic-if-needed
  if sim-time-seconds - last-vehicle-generation-time >= vehicle-generation-interval-seconds [

    let mode traffic-generation-mode

    if mode = "mixed" [
      set mode one-of ["car" "bus" "bike" "pedestrian"]
    ]

    generate-random-agent-from-pool mode
    set last-vehicle-generation-time sim-time-seconds
  ]
end

to-report nearest-origin-point [x y]
  let graph-points (turtle-set nodes waypoints) with [
    any? my-out-edges with [
      member? "car" allowed-modes
    ]
  ]

  if not any? graph-points [
    report nobody
  ]

  report min-one-of graph-points [distancexy x y]
end

to select.destination
  if mouse-down? [
    let p nearest-destination-point mouse-xcor mouse-ycor

    if p != nobody [
      set destination-point p

      ask p [
        set color magenta
        set size 0.18
      ]

      user-message "Destination selected."
    ]

    wait 0.2
  ]
end

to-report nearest-destination-point [x y]
  let graph-points (turtle-set nodes waypoints) with [
    any? my-in-edges with [
      member? "car" allowed-modes
    ]
  ]

  if not any? graph-points [
    report nobody
  ]

  report min-one-of graph-points [distancexy x y]
end

to-report shortest-path [source target mode]

  let graph-points (turtle-set nodes waypoints)

  ask graph-points [
    set dist 999999999
    set previous nobody
    set visited? false
  ]

  ask source [
    set dist 0
  ]
  let iterations 0
  let max-iterations 100000

  while [any? graph-points with [not visited?] and iterations < max-iterations] [

    set iterations iterations + 1

    let current min-one-of graph-points with [not visited?] [dist]

    if current = nobody [
      report []
    ]

    if [dist] of current = 999999999 [
      report []
    ]

    if current = target [
      report build-path source target
    ]

    ask current [
      set visited? true
    ]

    let outgoing-edges [my-out-edges with [
      member? mode allowed-modes
    ]] of current

    ask outgoing-edges [
      let neighbor end2
      let alt ([dist] of current) + road-length

      if alt < [dist] of neighbor [
        ask neighbor [
          set dist alt
          set previous current
        ]
      ]
    ]
  ]

  report []
end

to-report build-path [source target]

  let result []
  let current target

  while [current != nobody and current != source] [
    set result fput current result
    set current [previous] of current
  ]

  if current = source [
    report result
  ]

  report []
end

to create.vehicle.from.selection
  if origin-point = nobody or destination-point = nobody [
    user-message "Select an origin and a destination."
    stop
  ]

  set selected-path shortest-path origin-point destination-point "car"

  if empty? selected-path [
    user-message "It hasn't found a path between the origin and the destination."
    stop
  ]

  create-vehicles 1 [
    set color yellow
    set size 0.5
    set shape "car"
    set agent-mode "car"

    set current-node origin-point
    move-to current-node

    set destination-node destination-point
    set path selected-path

    set previous-node nobody
    set next-node nobody
    set speed-factor bounded-random-normal 1 0.15 0.6 1.4
    set speed kmh-to-netlogo-speed (vehicle-speed-kmh * speed-factor)
    set stopped? false
    set arrived? false
    set waiting-time 0
  ]

  highlight-selected-path

end

to highlight-selected-path
  if origin-point = nobody or empty? selected-path [
    stop
  ]

  let full-path fput origin-point selected-path
  let i 0

  while [i < length full-path - 1] [
    let a item i full-path
    let b item (i + 1) full-path

    let edg one-of edges with [end1 = a and end2 = b]

    if edg != nobody [
      ask edg [
        set color green
        set thickness 0.03
      ]
    ]

    set i i + 1
  ]
end

to-report nearest-graph-point [x y]
  let graph-points (turtle-set nodes waypoints)

  if not any? graph-points [
    report nobody
  ]

  report min-one-of graph-points [distancexy x y]
end

to-report kmh-to-mps [kmh]
  report kmh / 3.6
end

to-report kmh-to-netlogo-speed [kmh]
  if meters-per-netlogo-unit <= 0 [
    user-message "meters-per-netlogo-unit must be greater than 0. Execute setup."
    report 0
  ]

  report ((kmh-to-mps kmh) / meters-per-netlogo-unit) * seconds-per-tick
end

to update.mobile-agent.speed
  ask mobile-agents [
    set speed kmh-to-netlogo-speed (speed-kmh-from-mode agent-mode * speed-factor)
  ]
end

to-report two-digits [n]
  if n < 10 [
    report word "0" n
  ]

  report word n ""
end

to-report sim-clock
  let total floor sim-time-seconds
  let h floor (total / 3600)
  let m floor ((total mod 3600) / 60)
  let s total mod 60

  report (word two-digits h ":" two-digits m ":" two-digits s)
end

to export.world
  export-world "data/saved_graph_world.csv"
end

to export-results
  file-close-all
  file-open "outputs/simulation_results.csv"
  file-print "sim_time_seconds,number_of_vehicles,vehicle_speed_kmh,total_vehicles"
  file-print (word sim-time-seconds "," number-of-vehicles "," vehicle-speed-kmh "," count vehicles)
  file-close
end

to go-manual
  update.mobile-agent.speed
  move.mobile-agents

  set sim-time-seconds sim-time-seconds + seconds-per-tick
  tick
end

to go
  if sim-time-seconds >= simulation-duration-seconds [
    user-message "Simulation finished."
    stop
  ]

  generate-traffic-if-needed
  update.mobile-agent.speed
  move.mobile-agents

  set sim-time-seconds sim-time-seconds + seconds-per-tick
  tick
end

to initialize-simulation
  setup
  precompute-all-random-routes

  let mode traffic-generation-mode

  if mode = "mixed" [
    set mode one-of ["car" "bus" "bike" "pedestrian"]
  ]

  generate-random-agent-from-pool mode
  debug-route-pool
  set last-vehicle-generation-time sim-time-seconds
end

to demo-run
  setup
  create.vehicles

  repeat 100 [
    go
  ]

  export-results

  user-message "Demo finished. Results exported to outputs/simulation_results.csv"
end]]></code>
